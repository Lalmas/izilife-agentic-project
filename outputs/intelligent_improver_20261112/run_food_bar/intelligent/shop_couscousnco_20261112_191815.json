      "closed_state_id": "1",
      "google_reviews_json": "{\"place_id\":\"ChIJrf1Y4Aot3UcRHWdkgZnjU0k\",\"rating\":4.8,\"user_rating_count\":100,\"google_maps_uri\":\"https://maps.google.com/?cid=5283817036276066077\",\"fetched_at\":\"2026-11-12T19:18:01+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Un régal !!\\nCommande d'un couscous mixte pour 15 personnes, tout le monde s'est régalé, les petits comme les grands.\\nBien copieux, tout est fait pour le transport.\\nOn recommande :)\",\"language_code\":\"\",\"publish_time\":\"2026-10-12T17:03:03+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Mélanie Dupent\",\"uri\":\"https://www.google.com/maps/contrib/117120978773592201350/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVhYuvMG1D6wq3bRTDeuDFGrpbqjOKeJWCvwreiM1cwJfBrR6DCwQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Toujours délicieux\",\"language_code\":\"\",\"publish_time\":\"2026-03-11T19:39:10+00:00\",\"relative_publish_time\":\"il y a 8 mois\",\"author\":{\"display_name\":\"Valérie Bernard\",\"uri\":\"https://www.google.com/maps/contrib/107028281528373744617/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLhASaelLUY_HREhWUMA-1nLueEcDV9bUzAZvFzw56RMUEssQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Excellent tout est parfait\",\"language_code\":\"\",\"publish_time\":\"2026-01-09T09:51:15+00:00\",\"relative_publish_time\":\"il y a 10 mois\",\"author\":{\"display_name\":\"Céline ledru\",\"uri\":\"https://www.google.com/maps/contrib/112230398265954637218/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocL-F9OzQSpBrgr8VAm3kgOT4MH5FA_I2SptHQ6sMjtnp5bzTSC7=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Un grand merci au traiteur pour ce repas exquis.la commande .\\nLa commande pour 8 personnes était abondante et plaine de saveur.\\nLe couscous comme le tajine ont conquis tout le monde .\\nJe recommande vivement ce service de qualité !!!!!\",\"language_code\":\"\",\"publish_time\":\"2025-12-08T17:40:54+00:00\",\"relative_publish_time\":\"il y a 11 mois\",\"author\":{\"display_name\":\"Djamel Semmani\",\"uri\":\"https://www.google.com/maps/contrib/112264605619110581472/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKyCZ7H3RJrUnHdZsLUPNG7P4Dxxno4sRPXA2TnpLBB07GcYQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Nous avons adore notre repas !!!!!les saveur ete authentique ,la viande tendre et les legumes cuisinés a la perfection .un service impeccableet un traiteur tres sympathique .je recommande sans hesiter.\",\"language_code\":\"\",\"publish_time\":\"2025-12-08T17:36:03+00:00\",\"relative_publish_time\":\"il y a 11 mois\",\"author\":{\"display_name\":\"Hamid Hamened\",\"uri\":\"https://www.google.com/maps/contrib/112700771469302547773/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJQNmmNJ13rIwU8rizQ24FeLy08AEADRZrQgpmX-776nD45WA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
