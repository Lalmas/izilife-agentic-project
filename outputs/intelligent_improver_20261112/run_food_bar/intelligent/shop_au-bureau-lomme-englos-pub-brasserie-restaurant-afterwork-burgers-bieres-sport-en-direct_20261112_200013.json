            "rating": 5,
            "text": "Excellent restaurant.  Cuisine très bonne, personnel agréable et ptix correct ! Je conseille !",
            "language_code": "",
            "publish_time": "2026-11-07T17:16:26+00:00",
            "relative_publish_time": "il y a moins d'une semaine",
            "author": {
              "display_name": "Cathy Bultel",
              "uri": "https://www.google.com/maps/contrib/111967364972803650926/reviews",
              "photo_uri": "https://lh3.googleusercontent.com/a-/ALV-UjXE7XrypaTSwj-_E1qwZjcozsNBYWGqMlE91hHdYjGz-N2HJcZa=s128-c0x00000000-cc-rp-mo-ba5"
