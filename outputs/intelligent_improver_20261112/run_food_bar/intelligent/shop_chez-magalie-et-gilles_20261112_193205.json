      "google_reviews_json": "{\"place_id\":\"ChIJ33gErrYs3UcRwQLv92FLiW0\",\"rating\":4.5,\"user_rating_count\":125,\"google_maps_uri\":\"https://maps.google.com/?cid=7892922706087051969\",\"fetched_at\":\"2026-11-12T19:31:50+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":1,\"text\":\"5.50€, l’image par d’elle même…\",\"language_code\":\"\",\"publish_time\":\"2026-09-28T09:47:58+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Tom Tom\",\"uri\":\"https://www.google.com/maps/contrib/111606976556144453210/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIyQkRqtNH4s2xnrGIyVJHJKt7odAKLP47A8mbx6y-zz_2bKQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Super bon\",\"language_code\":\"\",\"publish_time\":\"2026-07-27T10:53:33+00:00\",\"relative_publish_time\":\"il y a 3 mois\",\"author\":{\"display_name\":\"Carrasco marie-jeanne\",\"uri\":\"https://www.google.com/maps/contrib/116021948945829973978/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjUpeUbSZTPoivoTAVy1-zJVFQ39fgoix1FVKJrKNiDyu-U1J_Lf=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Bien sur un bel accueil, sympa et chaleureux mais surtout des produits de très bonne qualité, la galette frangipane a certes un coût, mais elle a du goût, et c'est même très clairement la meilleure que j'ai pu manger du haut de mes 53 ans, sans exagérer ! Bravo pour cette qualité et votre accueil simple et sympa.\",\"language_code\":\"\",\"publish_time\":\"2026-01-28T17:11:23+00:00\",\"relative_publish_time\":\"il y a 9 mois\",\"author\":{\"display_name\":\"DAVID GALLET\",\"uri\":\"https://www.google.com/maps/contrib/113507758520533627618/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWBRDjN_j3snvxYJ5l7O_RnXdalRZ7a5qk0c4eEFv97ahLa6z9F=s128-c0x00000000-cc-rp-mo-ba6\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"La bûchette au café un vrai délice\",\"language_code\":\"\",\"publish_time\":\"2025-12-25T17:20:25+00:00\",\"relative_publish_time\":\"il y a 10 mois\",\"author\":{\"display_name\":\"Pauline Decool\",\"uri\":\"https://www.google.com/maps/contrib/116378332047904015306/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJ-dLDcI56zDp4PwGRET0Utmdo_vgChBBQBVCEj7OKrCF1iSw=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Excellent acceuil, baguette tradition excellente et bien cuite!\\nMerci Madame d'être ouverte un 11 novembre!\\nA visiter!\",\"language_code\":\"\",\"publish_time\":\"2025-11-11T09:23:57+00:00\",\"relative_publish_time\":\"il y a un an\",\"author\":{\"display_name\":\"Nathalie Vasseur\",\"uri\":\"https://www.google.com/maps/contrib/117236284020198535366/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWerjMR8N_UNYw0RFWUmuKusVRo1V5aRpVRZoFMtyb_hXD6SMRV=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"}]}",
