      "google_reviews_json": "{\"place_id\":\"ChIJI6j-hHbVwkcR7UChQhBBZws\",\"rating\":4.6,\"user_rating_count\":282,\"google_maps_uri\":\"https://maps.google.com/?cid=821696995111551213\",\"fetched_at\":\"2026-11-12T19:13:50+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Endroit très sympathique pour se poser, préfrable en été quand la terasse est mise sur la place, tous types de bières sont proposés, néanmoins attention le service ne se fait qu'au bar\",\"language_code\":\"\",\"publish_time\":\"2026-08-25T10:50:53+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Vic59\",\"uri\":\"https://www.google.com/maps/contrib/117369750293900628590/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXor3TXaWp6cXDuZqntETdjggp3yH58RtKpEOpIoEAxso9XdDE=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"La Casquette est un vrai bar de quartier avec une ambiance chaleureuse et décontractée, typique de Lille.\\n\\nLa proximité aux terrains de pétanque rajoute quelque chose d'exceptionnel au lieu.\",\"language_code\":\"\",\"publish_time\":\"2026-06-03T12:03:29+00:00\",\"relative_publish_time\":\"il y a 5 mois\",\"author\":{\"display_name\":\"Hugo Laval\",\"uri\":\"https://www.google.com/maps/contrib/109777156612281975255/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjX7Bs1GG3gje39-IIMUpnCVolaWN7gHhhRMhOZBbMMwE4S8_aLR=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Le meilleur endroit pour jouer à la pétanque et boire un godet avé les  copaingues 🤹🏽🍻\",\"language_code\":\"\",\"publish_time\":\"2026-05-12T20:40:26+00:00\",\"relative_publish_time\":\"il y a 6 mois\",\"author\":{\"display_name\":\"Charly Favorite\",\"uri\":\"https://www.google.com/maps/contrib/114081133480459724557/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVMsqmLmh9yiV9dsq0UQI4O_n6C5041xjhAbfjCdqMsunM6fGE=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-04-28T21:40:24+00:00\",\"relative_publish_time\":\"il y a 6 mois\",\"author\":{\"display_name\":\"Charlotte TAFFIN\",\"uri\":\"https://www.google.com/maps/contrib/107125684729031976639/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVeTBU1uddw59FRKr67v2BLFj5inkKubJPUiZmATiYNsz_DxLo=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Un super barman !!! J'ai perdu au criket mais j'ai gagné aux boules 🔥\",\"language_code\":\"\",\"publish_time\":\"2026-04-27T21:07:01+00:00\",\"relative_publish_time\":\"il y a 6 mois\",\"author\":{\"display_name\":\"José Guerra\",\"uri\":\"https://www.google.com/maps/contrib/105363492620210791189/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjX8ryjJ0PU0S7RcVDhQzpiMRiVaifQ87bXFX5ew_BR1TyNppW8u=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"}]}",
