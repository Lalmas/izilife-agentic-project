      "google_reviews_json": "{\"place_id\":\"ChIJ7wv4MB7TwkcRd08lMhwK3wg\",\"rating\":4.6,\"user_rating_count\":227,\"google_maps_uri\":\"https://maps.google.com/?cid=639240788326567799\",\"fetched_at\":\"2026-11-12T19:36:50+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"⭐⭐⭐⭐⭐\\n\\nExcellente expérience ! Un accueil chaleureux, un service au top et des plats délicieux. Tout était réuni pour passer un très bon moment. Une belle adresse que je recommande sans hésitation ! Nous reviendrons avec grand plaisir. 👏\",\"language_code\":\"\",\"publish_time\":\"2026-10-30T22:05:46+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Francois Goddyn\",\"uri\":\"https://www.google.com/maps/contrib/114144573725658512494/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJM4R3oIAZrtCXW236lpYFRzypynRWl3Dln81cvHELzRQHfWQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-10-12T18:58:04+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Bruno Rossiny\",\"uri\":\"https://www.google.com/maps/contrib/102313098127749718924/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjU6jnM0-v-kwYuMuud_19gRe-Ls09WgkvP5F-7weolre1eYWr50=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"Toujours bien reçu\\nCarte simple mais de qualité\",\"language_code\":\"\",\"publish_time\":\"2026-09-11T20:38:48+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"lizard marc\",\"uri\":\"https://www.google.com/maps/contrib/100187483400760639195/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVhqXdagnyqzdtSyjYntt0o3-RsyehYdi0YRiVDLNaIalb49Lwlow=s128-c0x00000000-cc-rp-mo-ba5\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Ambiance au top!!!!!\\nLe service est impeccable, a l'écoute et rapide.\\nLa qualité des plats est excellente, tout comme la présentation 👍\\nLa déco aurait éventuellement besoin d'une petite touche féminine (private joke haha) mais rien de bien méchant 😁\\nMerci Emilien et Alexis, et bisous à Toufik 😁😁\",\"language_code\":\"\",\"publish_time\":\"2026-08-29T19:27:36+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Pierre Mercier\",\"uri\":\"https://www.google.com/maps/contrib/104280426902010112367/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVuIKOkqjJLlUzEw6-Ud6KU04531SM1BFaRjqedCKyNOeWo9urCpQ=s128-c0x00000000-cc-rp-mo-ba6\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"5 🌟🌟🌟🌟🌟 ce lieu a changé oui énormément, lieu très fréquentable\",\"language_code\":\"\",\"publish_time\":\"2026-08-27T18:33:23+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Vincent TRICOTEAUX\",\"uri\":\"https://www.google.com/maps/contrib/107232111523308244718/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXZ5QVVyxxOZny9v-p8LhQcYH5rBowaS4KUWLPSfqTFA6QITbPGrQ=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"}]}",
