      "google_reviews_json": "{\"place_id\":\"ChIJGWYWSVHRwkcR5kwpNxOxsOA\",\"rating\":4.6,\"user_rating_count\":81,\"google_maps_uri\":\"https://maps.google.com/?cid=16190635356484881638\",\"fetched_at\":\"2026-11-12T19:48:10+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Une adresse qui mérite à être connue. La patrone Vanessa ainsi que son équipe sont des amours ultra pro et serviable (attention à Nico).\\nBref vous pouvez vous y rendre les yeux fermés !!\",\"language_code\":\"\",\"publish_time\":\"2026-11-08T21:25:22+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Antoine Bulte\",\"uri\":\"https://www.google.com/maps/contrib/100747029226904522794/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVg___l159K6VwRU0Dng0Lnc2UX9jR1vsmtex5NBmV9oa5JKpSI=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Le QG que l’on attendait dans le PEVELE ! Équipe au top ! Je recommande !\",\"language_code\":\"\",\"publish_time\":\"2026-11-08T21:22:23+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Lucas Ansart\",\"uri\":\"https://www.google.com/maps/contrib/101171449578523829971/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIwaPYC_0Nr04oTOi41nAW_gEq4oUBj3wwTJNcVK01vEsxVhg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Encore un bon moment chez maison goguette\",\"language_code\":\"\",\"publish_time\":\"2026-11-05T22:05:14+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Rémi Maniez\",\"uri\":\"https://www.google.com/maps/contrib/100727253663978679334/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIgpzveKu_fS6dmRHfMMVmKHe0J0rAY69dtrLSkDJw-QeIKcQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Notre nouveau spot...the place to be\",\"language_code\":\"\",\"publish_time\":\"2026-10-25T19:31:25+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Jeremy\",\"uri\":\"https://www.google.com/maps/contrib/114013214053056003673/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKerDTv8cS_zHjPKG0DK07LsReC18CP6uKNhbuoQTDSH88KPA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Très bon resto, je recommande fortement.\\nAccueil très chaleureux.\\nPaul et Camille.\",\"language_code\":\"\",\"publish_time\":\"2026-10-11T19:45:11+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Paul Watteel\",\"uri\":\"https://www.google.com/maps/contrib/108350391221584472174/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKY-g6MV58EqdyHQjd9LF7RALoOvW4vscDVeDgtMEsDlvg_O0E=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
