      "google_reviews_json": "{\"place_id\":\"ChIJD52oI3Qt3UcRbubGLeq17xw\",\"rating\":5,\"user_rating_count\":40,\"google_maps_uri\":\"https://maps.google.com/?cid=2085085169890813550\",\"fetched_at\":\"2026-11-12T19:45:03+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-11-06T19:58:40+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Remi Verschave (rem)\",\"uri\":\"https://www.google.com/maps/contrib/110987572799670404005/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLD16SNPGew0xCWRUluwum75x9ggJgSxzFvMCMHsS5Dee4_ZA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Super expérience ! Nous avons pu faire la visite de la brasserie, déguster des galopins de bière et acheter des bouteilles! C'était génial, nous repasserons nous repasserons pour faire le plein !\",\"language_code\":\"\",\"publish_time\":\"2026-09-06T09:49:34+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Lény Duhazé\",\"uri\":\"https://www.google.com/maps/contrib/105247571324239810555/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXiJ1L2Qp_WL1z1vlNYZKpC9Ctj6-pi0G-NR8fvTEVbnX2oQQ-g=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Bière avec un bon parfum, beau arôme.\\nA profitez avec modération mais faite vous plaisir.\",\"language_code\":\"\",\"publish_time\":\"2026-06-12T17:43:49+00:00\",\"relative_publish_time\":\"il y a 5 mois\",\"author\":{\"display_name\":\"Pierre\",\"uri\":\"https://www.google.com/maps/contrib/102530920148104990694/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocK0wqP_GeVpkoqREfH6P2JYPG250vVRjgQsx9hbQXRHXDTCyw=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-06-06T11:25:03+00:00\",\"relative_publish_time\":\"il y a 5 mois\",\"author\":{\"display_name\":\"Veronique Parquet\",\"uri\":\"https://www.google.com/maps/contrib/107062595398213362473/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKIpQoM_4i0bOMzE4UMtdGYXOv7Vd18gOh0UrEzql1Lg8pSGw=s128-c0x00000000-cc-rp-mo-ba5\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Très belle découverte 🤩.\\nOn a fait découvrir la Drache lors d’un événement professionnel. Agréable, bon et festive 🥳\",\"language_code\":\"\",\"publish_time\":\"2026-05-27T18:54:34+00:00\",\"relative_publish_time\":\"il y a 5 mois\",\"author\":{\"display_name\":\"Matthieu Nassif\",\"uri\":\"https://www.google.com/maps/contrib/112422213540363888376/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjU-yPwADfmk5-dI7vNSngw1kr1UAKUpAod19CQI9xvJdOuUXOk=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"}]}",
