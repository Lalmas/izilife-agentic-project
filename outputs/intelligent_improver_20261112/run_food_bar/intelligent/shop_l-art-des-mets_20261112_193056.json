      "google_reviews_json": "{\"place_id\":\"ChIJ1cUup2kp3UcR2Br5I7O0tQI\",\"rating\":4.7,\"user_rating_count\":889,\"google_maps_uri\":\"https://maps.google.com/?cid=195260840356158168\",\"fetched_at\":\"2026-11-12T19:30:43+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Le repas comme l'accueil a été au niveau de nos attentes, voir beaucoup plus.\\nUne toute, toute,toute petite remarque, le fonds musical un peu trop envahissant.\\nRAVIS\",\"language_code\":\"\",\"publish_time\":\"2026-11-12T14:58:22+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Patrick SPELBROIT\",\"uri\":\"https://www.google.com/maps/contrib/105808238439493870332/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocK6r_D97rTc67piqWJEPM8Wt52jrkuIuQMZDd5zTn8ipxvTOA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Chaque fois nous sommes accueillis avec de grands sourires. Chaque fois la carte met en appétit. Et chaque repas dans cette salle chaleureuse est une fête de goûts et de saveurs. Le service est attentionné et joyeux. Merci à toute l'équipe et à bientôt!\",\"language_code\":\"\",\"publish_time\":\"2026-11-11T17:27:20+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"pierre caradot\",\"uri\":\"https://www.google.com/maps/contrib/100460072083614888568/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVbWGeZ9mooYKyLRylx5UNWLSGzdlRxaTIbx_XGYW2kqh7VP_eY=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Personnel au top et la cuisine maison toujours aussi bon , merci pour ce bon moment\",\"language_code\":\"\",\"publish_time\":\"2026-11-11T17:22:03+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Louis Constant\",\"uri\":\"https://www.google.com/maps/contrib/105915955183418223870/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLgtVrDhs3leYZmsf2H_BkrwFAiLD_xtKawEQr5Lqzy0-zffA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"parfait, merci à notre serveur qui est d'une gentillesse et d'une disponibilité.....\",\"language_code\":\"\",\"publish_time\":\"2026-11-11T11:25:43+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"groux sabine\",\"uri\":\"https://www.google.com/maps/contrib/104585239019172745861/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVycG2D5qDrF8SG748wrl4WgTp8IKnh3-Ee40NtEp9gONkv1msq=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-11-08T12:49:06+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"aurelie billaut\",\"uri\":\"https://www.google.com/maps/contrib/108068199438258997232/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocI1Usgr2Neh_HWhfr_Cv6RhLtlvtFq9IFBsrC11n-ODdaI_HA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
