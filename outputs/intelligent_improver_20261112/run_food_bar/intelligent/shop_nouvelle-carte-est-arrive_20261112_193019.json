      "google_reviews_json": "{\"place_id\":\"ChIJ1WO0G2PVwkcRVw5oPV12N4s\",\"rating\":5,\"user_rating_count\":31,\"google_maps_uri\":\"https://maps.google.com/?cid=10031616837825334871\",\"fetched_at\":\"2026-11-12T19:30:06+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Excellente prestation pour le mariage,  les plats sont goûteux et frais. Sympathique,  arrangeant,  disponible. Brunch magnifique le lendemain.  Nous recommandons vivement, merci à Mr et Mme Dantin \\\"milles envies traiteur\\\".\",\"language_code\":\"\",\"publish_time\":\"2026-07-18T11:41:35+00:00\",\"relative_publish_time\":\"il y a 3 mois\",\"author\":{\"display_name\":\"Isabelle Froment\",\"uri\":\"https://www.google.com/maps/contrib/112560129017796946429/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXdDlqaZg_1c3RxPu-FsEU-M0w5SYL8T2Bup7am8MYep-Kwh3jKSg=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Excellente prestation également en entreprise et en toute occasion, je recommande ++\",\"language_code\":\"\",\"publish_time\":\"2026-05-26T16:38:27+00:00\",\"relative_publish_time\":\"il y a 5 mois\",\"author\":{\"display_name\":\"Karine RUCKEBUSCH\",\"uri\":\"https://www.google.com/maps/contrib/100915834042670228674/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjUG-p9nXu8v_sORZHeH3TkBV2qoRl5KgywEMq6IkcP5MLDPJarrHA=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Un grand merci à Mr Dantin et son équipe qui nous ont régalé pour la communion de notre fils.  Nous avions commandé des pièces de cocktails, 2 pains surprises et un repas chaud et tout était très bon! Nos convives se sont régalés !\\nMerci également à  Mr Dantin pour sa disponibilité, tant par mail que par téléphone afin de répondre à toutes les questions que je me posais.\\nNous ferons de nouveau appel à lui pour nos futurs événements familiaux !\\nMerci\",\"language_code\":\"\",\"publish_time\":\"2026-03-27T14:42:13+00:00\",\"relative_publish_time\":\"il y a 7 mois\",\"author\":{\"display_name\":\"Hélène LEROUX\",\"uri\":\"https://www.google.com/maps/contrib/100001336020883365548/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLrdRjFRMLKjn1Ay3zlhZh3QqV8wwWB-Ri9SeH0zrYcFq1Szw=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Un super repas de Noël !\\nJe recommande\",\"language_code\":\"\",\"publish_time\":\"2025-12-25T16:07:12+00:00\",\"relative_publish_time\":\"il y a 10 mois\",\"author\":{\"display_name\":\"France Bouly de Lesdain\",\"uri\":\"https://www.google.com/maps/contrib/115269483031507103793/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKhrtQYD4CXZDlvXfyuEXdB6pj7SdpvLl-kVpUXi3c5aOA55A=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Traiteur parfait!\\nPlats sont délicieux, excellente présentation et ponctualité!\\nJe recommande\",\"language_code\":\"\",\"publish_time\":\"2025-05-05T08:36:06+00:00\",\"relative_publish_time\":\"il y a un an\",\"author\":{\"display_name\":\"Leslie Leclair\",\"uri\":\"https://www.google.com/maps/contrib/106469075822625684364/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjUlBjL3yuBvSjg_j94G3VSZ0KyqPZOEkIasZ6VYYWrRKiievQ=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"}]}",
