      "google_reviews_json": "{\"place_id\":\"ChIJ9YWTwmPVwkcRhGfTvqZU1P8\",\"rating\":4.4,\"user_rating_count\":765,\"google_maps_uri\":\"https://maps.google.com/?cid=18434452249877112708\",\"fetched_at\":\"2026-11-12T19:40:02+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":3,\"text\":\"Je trouve ça bizarre que quand on commande un Coca 33 cl à presque 5 €, on nous serve un Coca 25 cl, et c'est la même chose pour les autres boissons\",\"language_code\":\"\",\"publish_time\":\"2026-11-08T13:22:21+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"T!M\",\"uri\":\"https://www.google.com/maps/contrib/111260056709006671444/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWWIR8YqRK6g88JGxrGxhe9l8YiFh8vuwIFzytdzE7GE593W-U=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Très bon restaurant\",\"language_code\":\"\",\"publish_time\":\"2026-11-07T22:45:50+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Charline Noppe\",\"uri\":\"https://www.google.com/maps/contrib/101927561451836574677/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJBg8bugguMtEzSRrFpUdeHY67YlqKg8F_kTr4Z4oG7gKoUow=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Une visite encore couronnée de succès 🥰\",\"language_code\":\"\",\"publish_time\":\"2026-11-07T13:24:43+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Mnbee 777\",\"uri\":\"https://www.google.com/maps/contrib/113433278594690009525/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVPyX1xLpUPIj1lrHwdhwIU0Pfrjo87IdEpVfk7sjVbxpRCE_k=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Juste délicieux ! Un somptueux mariage de deux pizzas,des ingrédients de qualité, un tiramisu aux fraises très bon et un acceuil très chaleureux.merci a sakina pour ces bons conseils ❤️\",\"language_code\":\"\",\"publish_time\":\"2026-10-26T20:26:01+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Fanny M\",\"uri\":\"https://www.google.com/maps/contrib/114194005920046792367/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJ734AsT3vAg477lUixoE7KovwShyDhlCUg-ubWa3e3bAnN5w=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Pizza très bonne, serveur très gentil et accueillant. Je recommande !!\",\"language_code\":\"\",\"publish_time\":\"2026-10-23T12:28:27+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Lou Cornu\",\"uri\":\"https://www.google.com/maps/contrib/115753257734336204693/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJqvQPdW37O8HcKkr_TAsNCdxHoLodM9idccqXKt_nFl86zUg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
