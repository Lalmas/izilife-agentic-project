      "google_reviews_json": "{\"place_id\":\"ChIJHa_U-Fgs3UcR67XARPLPJEU\",\"rating\":4.7,\"user_rating_count\":362,\"google_maps_uri\":\"https://maps.google.com/?cid=4982335727221126635\",\"fetched_at\":\"2026-11-12T19:50:23+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"C est bon ,copieux avec un accueil chaleureux,familiale,spontané...\\nJe revendique...\",\"language_code\":\"\",\"publish_time\":\"2026-11-10T10:56:04+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Fred Losc\",\"uri\":\"https://www.google.com/maps/contrib/116849268420995322760/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXKxDmyfC89ZQsyjivjsO8plBSCyCaGQ1it47Am0ZQ5Uz9sP1dR=s128-c0x00000000-cc-rp-mo-ba5\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Un steak tartare au couteau excellent ! Un dessert maison bien servi et somptueux ! C’est une adresse que je recommande !!!\",\"language_code\":\"\",\"publish_time\":\"2026-11-07T13:40:36+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"philippe delaude\",\"uri\":\"https://www.google.com/maps/contrib/111828990006879897246/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIrCZHQbKoPEiBlsTfFiGd0RxolduNp1HG7qe2iKspyDqPJGg=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Très sympa\",\"language_code\":\"\",\"publish_time\":\"2026-11-05T12:45:14+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Annie Sakowski\",\"uri\":\"https://www.google.com/maps/contrib/108293366997394994759/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKMHfJEJCLdOcYL9KxAL5elPDWwwzpqIFTIn9g1per2rUQspg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-10-24T12:16:36+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Marine Viseux\",\"uri\":\"https://www.google.com/maps/contrib/102219308513823117374/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXQB3BTSA_NaXIsnlzF39boceFV9kAuqX2TRvCL85chP_WSvUhHjA=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Très bons plats faits maison, savoureux et préparés avec soin. Les portions sont généreuses tout en restant raisonnables.\\n\\nL’ambiance est agréable et conviviale, le personnel est très sympathique.\\n\\nNous recommandons sans hésiter !\",\"language_code\":\"\",\"publish_time\":\"2026-10-05T16:06:49+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"clem\",\"uri\":\"https://www.google.com/maps/contrib/102130361386725676585/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjUn9zyrf7IgtutwZtTHVAh0DCBHwDoLpw5WF63S2hdXKyoWVUg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
