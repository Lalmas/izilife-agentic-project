      "google_reviews_json": "{\"place_id\":\"ChIJOxUmGYE63UcRVD0W0kgcFdA\",\"rating\":4.6,\"user_rating_count\":237,\"google_maps_uri\":\"https://maps.google.com/?cid=14993921633487830356\",\"fetched_at\":\"2026-11-12T19:58:21+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Très belle découverte au Briquet du Chevalet ! Un endroit chaleureux et convivial, un accueil très sympathique et un excellent repas. Nous avons passé un très agréable moment. Une adresse que je recommande sans hésitation !\",\"language_code\":\"\",\"publish_time\":\"2026-10-21T12:29:01+00:00\",\"relative_publish_time\":\"il y a 3 semaines\",\"author\":{\"display_name\":\"christelle laune\",\"uri\":\"https://www.google.com/maps/contrib/115029752304017457705/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVI2fJIZKpV0bLqKqsLenanqyy3b26SIMUY-ubwWH6HAdgcYKIF=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Très bonne ambiance, la nourriture est excellente et le personnel est comme ça 👌🏻.\\nJe recommande fortement, prévoir réservation par contre.\",\"language_code\":\"\",\"publish_time\":\"2026-10-01T11:46:16+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Kévin “DroidXace” Hatterer\",\"uri\":\"https://www.google.com/maps/contrib/117233848586588385561/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjUUTa-5o9GQj-p-Iwr1Ig7xwxHqXwGR8_O11xa9IvvLIV1xkjVVEQ=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Très bon, et le service impeccable\",\"language_code\":\"\",\"publish_time\":\"2026-09-11T16:28:00+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"lud h\",\"uri\":\"https://www.google.com/maps/contrib/111961662314642478648/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKYprr4RwNmXmW8nSnRkgG8uZ0ZYYql-hkyx795GsHIMGZFHA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Ambiance bon enfant, lieu convivial servi par une équipe sympathique\\nCuisine simple faite maison et copieuse\",\"language_code\":\"\",\"publish_time\":\"2026-09-11T12:13:31+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Eliane Milcent\",\"uri\":\"https://www.google.com/maps/contrib/117782331812404528114/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKFLR5v3ixHvg9mgNQBSo90esu9L4QP2k_xevy3gTvvF8TcOw=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Merci beaucoup pour votre accueil sympathique et chaleureux,du jour.\\n\\nUne cuisine du terroir,simple et  généreuse,et bienvenue surtout après la découverte du Terril des jumeaux 🤗\",\"language_code\":\"\",\"publish_time\":\"2026-09-01T15:54:08+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Loetitia Herbreteau\",\"uri\":\"https://www.google.com/maps/contrib/100459640351618227012/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXUGk9BHyTis-rs_jtkPr9fF4CMHqmKsPQweHO5Nx2kJCNIeYUt=s128-c0x00000000-cc-rp-mo-ba5\"},\"google_maps_uri\":\"\"}]}",
