      "google_reviews_json": "{\"place_id\":\"ChIJR2xOFWvVwkcRuKXIrKc-MmA\",\"rating\":4.9,\"user_rating_count\":13,\"google_maps_uri\":\"https://maps.google.com/?cid=6931671666355905976\",\"fetched_at\":\"2026-11-12T20:01:23+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Merci bonne service Omar\",\"language_code\":\"\",\"publish_time\":\"2026-01-12T23:56:58+00:00\",\"relative_publish_time\":\"il y a 10 mois\",\"author\":{\"display_name\":\"Khayreddine DZ\",\"uri\":\"https://www.google.com/maps/contrib/114752010434204494714/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLXFJcQJ3UaZT6fA5GrbdJ4qKWdunw6YCdF15JrijJ3VoaXhQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Franchement au top ! Les burgers sont super bons, bien garnis et les frites trop bonnes. Service rapide et sympa, je recommande sans hésiter 👌🍔\",\"language_code\":\"\",\"publish_time\":\"2025-10-17T23:12:34+00:00\",\"relative_publish_time\":\"il y a un an\",\"author\":{\"display_name\":\"Assiya\",\"uri\":\"https://www.google.com/maps/contrib/100872013070463261700/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLFyWnt0qo6Pw89se5o-kV0NOTNfhWl71UCP0FZV3mfE-tsmA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Toujours au top, livraison rapide\\nFast-food de qualité\\nJe recommande 🤙\",\"language_code\":\"\",\"publish_time\":\"2025-10-08T19:41:31+00:00\",\"relative_publish_time\":\"il y a un an\",\"author\":{\"display_name\":\"Audrey Cabirou\",\"uri\":\"https://www.google.com/maps/contrib/104318546080015747477/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIY-B4xTLduExpfSoyLkr6FykG40DZnhhhxkk50ThESZJej2A=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Personnel très accueillant et agréable. Les quantités sont généreuses et la qualité au rendez-vous. Je recommande fortement\",\"language_code\":\"\",\"publish_time\":\"2025-10-04T17:48:36+00:00\",\"relative_publish_time\":\"il y a un an\",\"author\":{\"display_name\":\"Guuilhem\",\"uri\":\"https://www.google.com/maps/contrib/101745540433404485674/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKaoJDsrWztraB3s-_hRluuVdJPE6-eruFko8-mbYCGUmzUtdA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2025-10-04T17:10:02+00:00\",\"relative_publish_time\":\"il y a un an\",\"author\":{\"display_name\":\"Wassim\",\"uri\":\"https://www.google.com/maps/contrib/117105480733896908283/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLnaEvHHGm1Zg783HqJL3okCL0iflNDFyhvcHaJz8vjNi8YiQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
