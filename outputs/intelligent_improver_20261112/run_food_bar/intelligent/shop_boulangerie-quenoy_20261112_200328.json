      "google_reviews_json": "{\"place_id\":\"ChIJS045zeHSwkcRU4UeoithNmw\",\"rating\":4.1,\"user_rating_count\":130,\"google_maps_uri\":\"https://maps.google.com/?cid=7797526644869989715\",\"fetched_at\":\"2026-11-12T20:03:18+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":4,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-11-01T06:49:59+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Bruno Gilleron\",\"uri\":\"https://www.google.com/maps/contrib/117886042418341290552/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKmfuW0h90zh_ENGt_Kjoy1TpOTSB-6agzWicyWZA80MqmpJA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Je suis passé ce matin pour prendre des croissants et pains au chocolat, cela faisait longtemps que je ne m'étais pas régalé avec de bonnes viennoiseries, le pain au chocolat et le croissant sont bien consistant, ont du gouts et remplissent vraiment bien l'estomac. Bon accueil également 😉\",\"language_code\":\"\",\"publish_time\":\"2026-10-16T18:28:34+00:00\",\"relative_publish_time\":\"il y a 3 semaines\",\"author\":{\"display_name\":\"Romain Declerck\",\"uri\":\"https://www.google.com/maps/contrib/104327313010577619061/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJh7bRFzjLxJjRopQLyHy19KwCu45eWt2EI8V72jh-pHEomuQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":1,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-09-19T04:04:23+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Elisabeth Eljasz\",\"uri\":\"https://www.google.com/maps/contrib/109458879443462201034/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIydCmgwhV5w4c1b6eM9SnZhhx7sSr7XS1OvFdmgTPHt8WqpZU=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"Fermé le jour oû j 'y suis allé\",\"language_code\":\"\",\"publish_time\":\"2026-09-05T19:57:21+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Cathy Saint Ghislain\",\"uri\":\"https://www.google.com/maps/contrib/105445129218875630909/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJVKEEr27CVg9bfIZbj3pIDmspF4uliSJC9yqw4qffViVBd9A=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Merci pour ce magnifique et délicieux gâteau 🎂\\n\\nMonique Poncelet\",\"language_code\":\"\",\"publish_time\":\"2026-08-17T13:09:47+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Monique Poncelet\",\"uri\":\"https://www.google.com/maps/contrib/106583468227474032472/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIRlBZn5-5VPTtiPFMViIK9AaQ2SP-JESbIJ9ewcWii8_3spw=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
