      "google_reviews_json": "{\"place_id\":\"ChIJM8ZCuLsv3UcRSdn24wbw0kc\",\"rating\":4.9,\"user_rating_count\":81,\"google_maps_uri\":\"https://maps.google.com/?cid=5175462834187196745\",\"fetched_at\":\"2026-11-12T19:55:34+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-11-02T16:14:04+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Geoffrey Platel\",\"uri\":\"https://www.google.com/maps/contrib/116749300343814968436/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjV2kraofTktAnn8CeB6ItAk96L0SLqjmRkIInOIaEmZINj26s8=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Superbe ambiance des gens très serviable et adorable 😍\",\"language_code\":\"\",\"publish_time\":\"2026-10-31T23:45:56+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Christophe Lebacq\",\"uri\":\"https://www.google.com/maps/contrib/117167984037755498330/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLNflBnGF7nPo34amj2Gl4ospx213_MKiHVzfISDCvmff6G=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Un lieu convivial, tout le monde peut participer au billard fléchettes et babyfoot.\\nJe recommande ce lieu\",\"language_code\":\"\",\"publish_time\":\"2026-09-18T22:40:09+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Timothée\",\"uri\":\"https://www.google.com/maps/contrib/105292569318320514402/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIMLwlVaiAsFxAjwQfthrzaNCySwjVwe-FWml_bFWIfU9ReEA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Dès qu'on a mis les pieds pour la toute première fois au Skål Bar quand on s'est installés à La Bassée, nous avons été très bien accueillis par les patrons. On s'est senti tout suite à l'aise avec eux et avec les autres clients, de passage ou habitués!\\n\\nL'ambiance est festive, familiale et bienveillante!\\n\\nQue ce soit pour faire une partie de billard, de fléchettes, se lancer dans un karaoké, regarder un match du 🟡🔴 RC Lens 🔴🟡 ou simplement pour boire un verre et papoter avec Gégé e Steph et avec les autres gens, c'est toujours avec le sourire qu'on passe la soirée !\\n\\nEt, très très important, contrairement à d'autres bar qui restent ouverts un peu plus tard la nuit, je me sens super tranquille d'y aller seule!\",\"language_code\":\"\",\"publish_time\":\"2026-08-01T18:14:41+00:00\",\"relative_publish_time\":\"il y a 3 mois\",\"author\":{\"display_name\":\"Marianna Pastore\",\"uri\":\"https://www.google.com/maps/contrib/106514621796958775662/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjU2t13Js2Jrptpv45I6drRnU6-LnoGPYkVTIBHYNXIHrhye5U8yAA=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Patron très sympathique très agréable et accueillant, bonne ambiance , je recommande fortement\\nMarvin & Maëva\",\"language_code\":\"\",\"publish_time\":\"2026-07-24T22:00:00+00:00\",\"relative_publish_time\":\"il y a 3 mois\",\"author\":{\"display_name\":\"Aevam Séléna\",\"uri\":\"https://www.google.com/maps/contrib/110275320923210401234/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJugAs8_9WZKTsjri17lNKu0ljfpw1hOmxynd00aqsYOcKRsA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
