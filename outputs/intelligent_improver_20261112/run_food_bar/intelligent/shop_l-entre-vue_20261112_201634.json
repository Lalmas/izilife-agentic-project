      "google_reviews_json": "{\"place_id\":\"ChIJY6U3JtjVwkcRb3fir8CgDQU\",\"rating\":4.9,\"user_rating_count\":91,\"google_maps_uri\":\"https://maps.google.com/?cid=364123894331897711\",\"fetched_at\":\"2026-11-12T01:28:23+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Un restaurant très chaleureux, très accueillant, une cuisine simple et nourrissante dans une bonne ambiance\",\"language_code\":\"\",\"publish_time\":\"2026-11-06T20:29:15+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Marie-Rachel Jolivet\",\"uri\":\"https://www.google.com/maps/contrib/104263372619013791476/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjV0bCuiZQVeYII_P64gFudrs2nYYTEyTB_dKEg4j5ROZFBsTzhwNQ=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-10-16T11:30:41+00:00\",\"relative_publish_time\":\"il y a 3 semaines\",\"author\":{\"display_name\":\"quentin puchois\",\"uri\":\"https://www.google.com/maps/contrib/109126516359558113128/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJm0pyHvhHmfcITgVPW504jA6qCT6zTuB2dh11P-jLNLPpuuQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":2,\"text\":\"Très Bonne qualités de service ,personnel très sympathique.cuisine simple mais très Bonne et bien cuisiné. Repas de groupe et la majorité des personnes étaient satisfaites .\",\"language_code\":\"\",\"publish_time\":\"2026-10-15T14:06:32+00:00\",\"relative_publish_time\":\"il y a 3 semaines\",\"author\":{\"display_name\":\"Annie Lepan\",\"uri\":\"https://www.google.com/maps/contrib/103308799740989544550/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJYONZRgCn-IG_G--Ltyi_uIv9m73h9gAnP4E1_OVNqEu2s-A=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Super restaurant ! Plat excellent, accueil excellent et personnel adorable ! Je recommande ++++\",\"language_code\":\"\",\"publish_time\":\"2026-10-09T11:48:48+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Brunhilde C\",\"uri\":\"https://www.google.com/maps/contrib/118185581140463544872/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWJDmIg6QqLrOipeLmWCpnPQmy3zK0BHAMubmbASkztauIDfIY=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Super rapport qualité prix !\",\"language_code\":\"\",\"publish_time\":\"2026-10-06T10:09:13+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Marie Berkmans\",\"uri\":\"https://www.google.com/maps/contrib/113788229425731994083/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVQT-9LlyB3B9DCR8XUG2-HFkB1wwgkwMwJyvoGHiBL0oa853kk=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"}]}",
