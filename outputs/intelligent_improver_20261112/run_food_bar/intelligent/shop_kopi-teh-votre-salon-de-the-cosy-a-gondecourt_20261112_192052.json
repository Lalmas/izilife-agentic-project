      "google_reviews_json": "{\"place_id\":\"ChIJH0mZskYt3UcRJVfU3OFOpLc\",\"rating\":4.9,\"user_rating_count\":21,\"google_maps_uri\":\"https://maps.google.com/?cid=13232788337100871461\",\"fetched_at\":\"2026-11-12T04:08:33+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Le shortbread est une tuerie ne partez pas sans le goûter ! Parole de gourmande 😝😋\",\"language_code\":\"\",\"publish_time\":\"2026-09-05T20:55:18+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Leslie Lopes\",\"uri\":\"https://www.google.com/maps/contrib/107647314756717908369/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXJH9_c4cX1BgK1DtRT5oOJPV7uobjC2zNbzL8yVFFPGkSlHZU=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Génial. Endroit très agréable pour se poser, papoter entre copines. Nous y avons très bien mangé et bu, pour un très bon rapport qualité prix. Nous y avons été super bien reçue, la gérante est adorable !\",\"language_code\":\"\",\"publish_time\":\"2026-07-17T12:05:39+00:00\",\"relative_publish_time\":\"il y a 3 mois\",\"author\":{\"display_name\":\"Clara Chilaud\",\"uri\":\"https://www.google.com/maps/contrib/112115734152958706580/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKuYdCs1CBcH-qkzQIETfg-Emfy87u8L2WqUlPysK74bDKBOA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Ce salon de thé est une très belle adresse. Un cadre ressourçant et apaisant, de délicieuses pâtisseries et boissons, une boutique de créateurs locaux et un accueil chaleureux, je recommande 😊\",\"language_code\":\"\",\"publish_time\":\"2026-06-06T08:43:53+00:00\",\"relative_publish_time\":\"il y a 5 mois\",\"author\":{\"display_name\":\"Fanny Robin\",\"uri\":\"https://www.google.com/maps/contrib/105040826420625863455/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLf6gLYGPNSzlWSpU-SGgopCskYDx6HmONB0kpMjJgPCdlHJA=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-05-23T15:32:25+00:00\",\"relative_publish_time\":\"il y a 5 mois\",\"author\":{\"display_name\":\"Thierry Blancke\",\"uri\":\"https://www.google.com/maps/contrib/110910424581126686371/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJ6BdHZLcQz5XF92dDDNHndkhS-oaaBiylEO8hQp88tBIAaJg=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Super moment de détente après une petite balade en vélo. Mon mari, mes enfants et moi-même avons adoré ce petit instant volé en mode cocooning 💞\",\"language_code\":\"\",\"publish_time\":\"2026-04-16T15:39:52+00:00\",\"relative_publish_time\":\"il y a 6 mois\",\"author\":{\"display_name\":\"Lucie Vdd\",\"uri\":\"https://www.google.com/maps/contrib/110824532284684530285/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIzZ-ktvp10JG4itv29VJygMxcLFSigeU2rtleMDon7L7Hs5Q=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
