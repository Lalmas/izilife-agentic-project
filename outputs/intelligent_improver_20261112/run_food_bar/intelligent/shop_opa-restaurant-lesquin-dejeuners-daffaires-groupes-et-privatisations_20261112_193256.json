      "google_reviews_json": "{\"place_id\":\"ChIJ3_QdMP_XwkcR14H8td60WUQ\",\"rating\":4.7,\"user_rating_count\":662,\"google_maps_uri\":\"https://maps.google.com/?cid=4925166536135311831\",\"fetched_at\":\"2026-11-12T19:32:42+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-11-10T20:56:24+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Raph Coudray\",\"uri\":\"https://www.google.com/maps/contrib/112490595656728328104/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXyEljdXb76GfT9uzr63A8pM7-m89PbzlBPrXwcC2xTiZ3K4vRp=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Toujours très bien, la carte varie souvent, c'est savoureux et les desserts bien gourmands ! Accueil très sympa !\",\"language_code\":\"\",\"publish_time\":\"2026-11-06T14:50:55+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Alexane Evrard\",\"uri\":\"https://www.google.com/maps/contrib/105320159198038413383/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjX8p7D-tyxMcGvoNMf0HNqGScSw_jFoC7VVd_NFwGO8ER09qLJC=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Lieu superbe, plats délicieux, ambiance sympa, je recommande les yeux fermés !\",\"language_code\":\"\",\"publish_time\":\"2026-11-05T05:55:06+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Aline BARTKOWIAK\",\"uri\":\"https://www.google.com/maps/contrib/117813944081700354056/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLXrWRFtEtwoxqk5XlDrI0sgH-e6Wi5BHQt1K7n_BG2aRNR0A=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-11-04T14:17:33+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"ANGEL JIMENEZ\",\"uri\":\"https://www.google.com/maps/contrib/111033129506403067571/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjU8Tr2tfAWxH2YMqIvqtlw24FTQq2VM2LWbt79ucq_Yz8bhAss=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"En déplacement dans la région, j'ai eu la chance de trouver cet établissement !\\nDe jolis plats délicieux et bien équilibrés.un excellent rapport qualité prix, c'est une très belle adresse. Un très bon service dans un cadre agréable. Merci pour ce moment\",\"language_code\":\"\",\"publish_time\":\"2026-11-03T20:46:07+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Xavier BOULARD\",\"uri\":\"https://www.google.com/maps/contrib/108147888550845651009/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJa34zy_oIYuTExSH_c_38-4sxSAsxqqx_aJ5DY7MbuPGxcWA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
