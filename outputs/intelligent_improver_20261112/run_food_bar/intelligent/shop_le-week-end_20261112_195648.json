      "google_reviews_json": "{\"place_id\":\"ChIJNaEhkm_UwkcRLeoJJT2t9ts\",\"rating\":4.2,\"user_rating_count\":91,\"google_maps_uri\":\"https://maps.google.com/?cid=15850046416703056429\",\"fetched_at\":\"2026-11-12T19:56:31+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"On peut boire, manger très varié. Ils ont une grosse carte brasserie.\\nAccueil super sympa de toute l’équipe\\nTop pour une pause dej’ relax\",\"language_code\":\"\",\"publish_time\":\"2026-09-25T12:16:08+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Philippe Hamelin\",\"uri\":\"https://www.google.com/maps/contrib/103804060860368338923/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIMPMrmCqRce8iPz41gk5iUoQbEsC-aBcDaOUTG21qii1e2=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-08-20T14:24:00+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Gaetan Leal\",\"uri\":\"https://www.google.com/maps/contrib/111408111644614029185/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVnFVQ-6szhm_uC6KuVY73loPlADVKARtwXQMKyBYHcC1SaiUxD=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"Nous avons passé un super bon moment ! Serveuse ainsi que le responsable était très agréable et souriant, ça fait plaisir ! Bonne ambiance, braséro nickel le boeuf cuit comme on aime.\\nSeul point négatif pas de clim, nous n'avons pas pu profiter des flippers a l'intérieur...\\nBonne partie de fou rire avec la pétanque dommage pas de lumière a l'extérieur pour pouvoir plus profiter après le repas.\\nJe recommande vivement.\",\"language_code\":\"\",\"publish_time\":\"2026-07-04T19:20:32+00:00\",\"relative_publish_time\":\"il y a 4 mois\",\"author\":{\"display_name\":\"Béatrice\",\"uri\":\"https://www.google.com/maps/contrib/101003969269861906431/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWnBz2ElFxahTDUhh0ltD86N_L3PgUzQIWlEifJ6gA50IA16us=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Endroit très sympathique pour manger sur le pouce, terrasse très agréable et service au top 👌\\nMerci pour l'accueil, on reviendra pour goûter le tacos 😊\",\"language_code\":\"\",\"publish_time\":\"2026-06-23T16:58:50+00:00\",\"relative_publish_time\":\"il y a 4 mois\",\"author\":{\"display_name\":\"Tatiana Leuliet\",\"uri\":\"https://www.google.com/maps/contrib/102327029513298871933/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKPbIwd5l_Jt6g9wh784KUchHiMOWKHn9FqZaPnAC_RdBobSrtj=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"LE BAR TABAC à ne pas louper ! Large choix de bières , cocktails , tapas , et petite restauration le midi !\\nTerrain de pétanque et flipper à disposition !\\n\\nAu plaisirs\",\"language_code\":\"\",\"publish_time\":\"2026-06-10T14:41:11+00:00\",\"relative_publish_time\":\"il y a 5 mois\",\"author\":{\"display_name\":\"Florent TiFlo\",\"uri\":\"https://www.google.com/maps/contrib/104402345318983608783/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXDve8f6lTCri4TsGrRqPxHlvC133NT0sgjmWkTdBjOQjtenkgu=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"}]}",
