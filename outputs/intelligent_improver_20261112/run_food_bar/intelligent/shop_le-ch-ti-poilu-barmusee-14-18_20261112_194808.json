      "closed_state_id": "1",
      "google_reviews_json": "{\"place_id\":\"ChIJFz4w3Rot3UcR4-wnMcjxbtM\",\"rating\":4.9,\"user_rating_count\":76,\"google_maps_uri\":\"https://maps.google.com/?cid=15235380431561420003\",\"fetched_at\":\"2026-11-12T19:47:53+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":4,\"text\":\"Lieu atypique sur le thème des poilus,  chaleureux, mérite donc un détour.  Le musée est un plus.  Le personnel est agréable, les planches sont de qualité. A faire aussi en complément du fort de Seclin.\",\"language_code\":\"\",\"publish_time\":\"2026-11-11T19:07:57+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Hugues HOCHART\",\"uri\":\"https://www.google.com/maps/contrib/105696467336577426922/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjV2l2IGogApB6rmGY4635O0ZGcD3noNH27Wtvpfl2QqJukJYiRY=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"Lieu très sympathique,  ambiance au rendez-vous,  nous avons passé un très bon moment,  le petit plus..... quelques pièces très rares au musée.  A voir.\",\"language_code\":\"\",\"publish_time\":\"2026-11-11T14:19:06+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Marie-Hélène Bacquet\",\"uri\":\"https://www.google.com/maps/contrib/114927608180159217908/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKyzUqEVopqjLHWfDqmS81D_irmQZrXZiECL6dnsaLAeZ4o9g=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"acceuil sympathique d un passionné .\\ntres belle experience  si vous passez à proximité , arretez vous .\",\"language_code\":\"\",\"publish_time\":\"2026-09-08T20:02:02+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Jonathan Villaume\",\"uri\":\"https://www.google.com/maps/contrib/100400720371139904618/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWLrY7pCp35NhWRYiEFLkC5jp_j8HFY_QDfbVGQu6H34k5xbgxP=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-09-06T15:47:21+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"michael michalak\",\"uri\":\"https://www.google.com/maps/contrib/109439747637561697921/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjUq5T8hmFUD8ToOvWTBEWACdyzU_4QRXn1zkLaar3aLs5ROo_Z2GA=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Très bonne ambiance et nourriture de qualité je recommande\",\"language_code\":\"\",\"publish_time\":\"2026-09-06T15:25:03+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Soren Michalak Lesage\",\"uri\":\"https://www.google.com/maps/contrib/115190889887218134201/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjU-SQnzcRvAuiVPi9b-fTFj_wX-zL2nmKh4f4TbhXEKqWxNKOPE=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
