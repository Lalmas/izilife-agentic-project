      "google_reviews_json": "{\"place_id\":\"ChIJ81buYPHJwkcRcPCTG9lTjJQ\",\"rating\":4.7,\"user_rating_count\":400,\"google_maps_uri\":\"https://maps.google.com/?cid=10704022606288515184\",\"fetched_at\":\"2026-11-12T19:37:17+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Un endroit comme j'en cherchais depuis longtemps sur le Douaisis !\\nUn moment agréable, un endroit cosy, une infusion délicieuse ! Et pour les fan de chocolat comme moi: prenez le brookie sans aucune hésitation !\\n\\nMerci pour ce moment, et j'ai hâte de revenir !\",\"language_code\":\"\",\"publish_time\":\"2026-11-10T20:11:47+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Blandine Arcangeli\",\"uri\":\"https://www.google.com/maps/contrib/109541916683123403121/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVSpjd-BJ9Fy4VpWpLug47ineiO1Qpw--IO-g2J1YLjujjCoB5a=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"Hrane nisem poskusil, storitev kljub težavam (jezik) super, le nad kavo nisem bil navdušen\",\"language_code\":\"\",\"publish_time\":\"2026-10-26T21:42:12+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Samo Šinko\",\"uri\":\"https://www.google.com/maps/contrib/113898342319303536103/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVBPzxf9Dwlrl-OpHzn50P2dEtaWJuVtVxqClpx_E2sv1AnjXg=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Un accueil et un service chaleureux, des plats et un brunch de qualité pour excellent rapport qualité-prix, je peux que que recommander ! 😊\",\"language_code\":\"\",\"publish_time\":\"2026-10-25T16:53:03+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Sasiharan Jazz\",\"uri\":\"https://www.google.com/maps/contrib/101875069289440461630/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjU1kNBj7hdiKXt1MoMFCw_ER67MDRozYPll2ywNz7daO-nrfvPHoA=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-10-11T14:13:45+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Victor Dochita\",\"uri\":\"https://www.google.com/maps/contrib/110032901492511389729/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWLkzm0RvKv78JbyX9S2v4YOKHhkOKjW_sdMRmQgBRze8oywlYX=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"Bonne adresse sur pour un dejeuner sur Douai.\",\"language_code\":\"\",\"publish_time\":\"2026-10-03T08:22:16+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"aude van damme\",\"uri\":\"https://www.google.com/maps/contrib/109725264140553332247/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWg0OPFBAogeaZYjmXycNxhc9_ScRjrasZ6VjJhKLzaxtWi-v0vCA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
