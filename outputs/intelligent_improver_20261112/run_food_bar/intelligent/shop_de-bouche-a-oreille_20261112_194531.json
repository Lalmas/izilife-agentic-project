      "google_reviews_json": "{\"place_id\":\"ChIJDS3AEAEr3UcRn20B7YGR5jE\",\"rating\":4.5,\"user_rating_count\":809,\"google_maps_uri\":\"https://maps.google.com/?cid=3595721339715022239\",\"fetched_at\":\"2026-11-12T19:45:16+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":1,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-11-08T15:19:28+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Alain Vanhoecke\",\"uri\":\"https://www.google.com/maps/contrib/100700188197810122165/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLzvON_Z7hq1wkhJCyEdn_TXV-fBNPv945bs5EfMShcxRZHxA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Très sympa, ambiance familiale. Typique du coin, nous avons apprécié la bière et le welsh avant de repartir par chez nous!\",\"language_code\":\"\",\"publish_time\":\"2026-11-07T23:22:14+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"La Buse\",\"uri\":\"https://www.google.com/maps/contrib/104884927837804542583/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVgjop5YfCWRMaXdgtLV6IvGKBcez8mS-AQHGLj9IDHuPhYssI=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Cuisine excellente et personnel très accueillant et professionnel. Je recommande les yeux fermés\",\"language_code\":\"\",\"publish_time\":\"2026-11-02T18:02:16+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Francine Dewasmes\",\"uri\":\"https://www.google.com/maps/contrib/114952220525527539046/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVGR8ATTcp1P5eOm-q1l5ZbxTdkdnFbxWge8Stxbqrx2ZB4sdqTDA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Sommes venus pour mon anniversaire franchement je ne regrette pas j’ai apprécié la cuisine il y avait une bonne ambiance le patron a l’écoute et un très bon service champagne offert par la maison franchement Nikel je conseille vivement à refaire 👋\",\"language_code\":\"\",\"publish_time\":\"2026-11-01T19:09:13+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"alain martel\",\"uri\":\"https://www.google.com/maps/contrib/109706306751718489497/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIoGqgSAS67hBhoVgvg-JnCm1QKoa70a6QbuBaqysu4c3p70A=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Superbe restaurant typique repas au top service au top  ambiance conviviale et chaleureux mention spéciale au serveur Quentin   Les sudistes\",\"language_code\":\"\",\"publish_time\":\"2026-10-24T18:52:33+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"christophe guignard\",\"uri\":\"https://www.google.com/maps/contrib/104757627996414141727/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJzot3JE-KF6YdjGn9Rquwhtl1cwzKLzGPMLXLwD4RwvvR1Kg=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"}]}",
