      "google_reviews_json": "{\"place_id\":\"ChIJebSIUr3TwkcRMQYQbytF1g8\",\"rating\":5,\"user_rating_count\":115,\"google_maps_uri\":\"https://maps.google.com/?cid=1141175608434230833\",\"fetched_at\":\"2026-11-12T19:17:23+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-11-10T15:38:22+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Sylvie Feron\",\"uri\":\"https://www.google.com/maps/contrib/114535306990032887355/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLQvhYNQN6UVediCp52IRCNbW2HgZ8EDk1NCmKNl3ZK2oSC6g=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Entree là pour un en cas, j’ai decouvert un lieu chaleureux, un service attentionné et surtout un plat du jour absolument delicieux ( thon/ brocoli). Bref, une super experience que je renouvellerai tres volontiets.\",\"language_code\":\"\",\"publish_time\":\"2026-10-24T11:33:45+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Viviane Nawrot Pennequin\",\"uri\":\"https://www.google.com/maps/contrib/109296439407830526118/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLuqTVwXxdUW731Vn2OvY9x7rQu9oMKtAjZ9iE711oyHSaLiQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Une restaurant cosy, comme à la maison. On s'y régale et on est accueilli avec gentillesse. Prix abordables et produits de qualité.\",\"language_code\":\"\",\"publish_time\":\"2026-10-23T15:11:17+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Melanie Dubart\",\"uri\":\"https://www.google.com/maps/contrib/115030276109974488006/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjUIzMFJ8cu8_z9C24jrkl0YWpH887QVjHktEy5l0vKNDLEVqls=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-10-10T06:18:06+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"jacqueline breton\",\"uri\":\"https://www.google.com/maps/contrib/115276601958392313499/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKjOwBHOt0xnVaMs3HqdArlpUhNdH6wPx3m_ERMv_M0PsAjUg=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-10-06T16:19:41+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Sylvie Bouthier\",\"uri\":\"https://www.google.com/maps/contrib/111989587719730842405/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXFYOFvAof_4w3Gn7t9aSVoxtUg57f6rNMfpf56hfIg97pVyO9D=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"}]}",
