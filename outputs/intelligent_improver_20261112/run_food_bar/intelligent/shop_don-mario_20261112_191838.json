      "google_reviews_json": "{\"place_id\":\"ChIJa1eU9fXUwkcR90LAXInwIhs\",\"rating\":4.2,\"user_rating_count\":312,\"google_maps_uri\":\"https://maps.google.com/?cid=1955389660989506295\",\"fetched_at\":\"2026-11-12T19:18:25+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":3,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-10-07T22:39:06+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Minh Nguyen\",\"uri\":\"https://www.google.com/maps/contrib/106417799333002386783/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVv8s46IjV9JH77EWjvaJcL2lvBsY_PEmCHGP3V3pFR6oKTx4WE=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Nous avons très bien mangé, Alex et Victor étaient nos serveurs et nous ont fait passer un très bon moment\",\"language_code\":\"\",\"publish_time\":\"2026-08-31T02:09:22+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Guillaume DIEZ-SOTO\",\"uri\":\"https://www.google.com/maps/contrib/112667429860462720723/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIx4NIwmizMjZk98IBLcgSVDo_S6mF2vKGh3OBl8zeKvPXzlA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":1,\"text\":\"Bonne pizza.\\nPas assez cuite, glaire de l’œuf présent.\\nDeux pizzas pour mon appétit.\\nUne seule bière.\\nQue du rosé.\\nPas de dessert.\\nOn est dans le bled ?\",\"language_code\":\"\",\"publish_time\":\"2026-08-19T11:29:50+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"patrick vanaerde\",\"uri\":\"https://www.google.com/maps/contrib/102237557023312727695/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWgoF-SimEdM-cR60q3shEVF3_ECTuJOgGB1s9RftGV1PS9s3Mx=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":1,\"text\":\"Pizza de merde il n’y a que de l’huile c horrible ça coûte cher pour rien fuyez\",\"language_code\":\"\",\"publish_time\":\"2026-06-13T09:47:08+00:00\",\"relative_publish_time\":\"il y a 5 mois\",\"author\":{\"display_name\":\"Naruto Uzumaki\",\"uri\":\"https://www.google.com/maps/contrib/106570130898566997392/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXrQg_40E3e7IPn9jEVXFmZBs3n_TmKonJMrBXwP9vfgoaIhNs=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"Très bon\",\"language_code\":\"\",\"publish_time\":\"2026-06-04T22:53:14+00:00\",\"relative_publish_time\":\"il y a 5 mois\",\"author\":{\"display_name\":\"Herné Sandrine\",\"uri\":\"https://www.google.com/maps/contrib/100966601123822302914/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJRpu6jZl4-sld-oaakuqxb-K3ae4jihRINqJFyEodmm12rVg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
