      "closed_state_id": "1",
      "google_reviews_json": "{\"place_id\":\"ChIJPSFyfPEq3UcRZYdbPZRjErI\",\"rating\":4.4,\"user_rating_count\":2120,\"google_maps_uri\":\"https://maps.google.com/?cid=12831427776667682661\",\"fetched_at\":\"2026-11-12T19:59:00+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Excellent sur toute la ligne, de l'accueil au repas en passant par l'ambiance du lieu. Nous avons passé une super soirée,rien à redire.\",\"language_code\":\"\",\"publish_time\":\"2026-11-06T08:03:01+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Martin Lemahieu\",\"uri\":\"https://www.google.com/maps/contrib/105977395334232854751/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjV6oavPEczbd03nsomUsTaHv6YodEw7PlpdNnhVMrHjgrpOBXXo=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Un estaminet comme on les aime. De bons plats régionaux et un cadre sympathique. Nous nous sommes régalés !\",\"language_code\":\"\",\"publish_time\":\"2026-11-05T13:58:39+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Alexandre Olivier\",\"uri\":\"https://www.google.com/maps/contrib/115781999504436300751/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKrPx4w5kaewOf843iqmOxy6Hd_t3WYw2k8-zlwCD2_Ew-hzA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Un lieu sympathique et où nous avons très bien mangé. Le service était parfait\",\"language_code\":\"\",\"publish_time\":\"2026-11-02T09:58:32+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Valérie “Valoudebeuvry” Parent\",\"uri\":\"https://www.google.com/maps/contrib/103459124428685928658/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIRGGm9Hsi7ah5JGkIj9Cg7KWgqULjH45NpPY_q1fiCI9o7EA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"C’était bon et de bonne qualité, un peu chère mais belle découverte .Le restaurant est très bruyant.Nous aurions aimé qu’on nous propose de l’eau pour nos chiens comme les autres restaurants l’ont fait par la suite\",\"language_code\":\"\",\"publish_time\":\"2026-10-31T20:10:29+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Roxane Vatore\",\"uri\":\"https://www.google.com/maps/contrib/107081204961321899696/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjV9GhFeFRoBNG2EP-1zlE_sxcsZ4IPuEc8TI_cwCiKVf_IPmxWR=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":3,\"text\":\"Beaucoup trop long à servir.\\nNous étions un midi entre collègues et avons attendus nos plats plus d'une heure.\\nTartare avec bcp trop de tomates à l'intérieur. Pas mauvais mais pas génial.\\nPar ailleurs la note m'a semblé très élevée (23€ pour un plat et une boisson)\\nBref déçu.\",\"language_code\":\"\",\"publish_time\":\"2026-10-30T17:24:57+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Marc Thieffry\",\"uri\":\"https://www.google.com/maps/contrib/102626431192836766263/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocL7uZTKWcClyeedkarTE8z7Zls9XasDzUbDCzY7Ejqkq6-aLw=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"}]}",
