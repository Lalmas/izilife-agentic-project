      "google_reviews_json": "{\"place_id\":\"ChIJ505V68op3UcRFC0bK-a3bUg\",\"rating\":4.9,\"user_rating_count\":62,\"google_maps_uri\":\"https://maps.google.com/?cid=5219029742385835284\",\"fetched_at\":\"2026-11-12T19:34:09+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-10-24T06:16:58+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Beatrice Wieczorek\",\"uri\":\"https://www.google.com/maps/contrib/102480958430769903533/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJqWBdAo9bVyOBJmIqMpuuWp6T3y0QHnu2HWguv8X9mZS8Onw=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Au fond de la zi d'herlies. De l'autre côté de la belle piscine municipale...\\nAmbiance très happy lors des évènements (concerts ou djs les vendredis et des fois Le samedi).ˆ\\nEquipe au top et proche des clients, bières brassées sur place très quali (triple, blonde et ipa). À découvrir pour tout amateur de sons et de convivialité houblonnée 🧌🧌.\\nMerci à l'équipe et à sa gentille clientèle.\",\"language_code\":\"\",\"publish_time\":\"2026-10-03T00:17:12+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Max & Obby\",\"uri\":\"https://www.google.com/maps/contrib/108830484053317725429/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWkxeDIzpp67IFDQ6xEwCTYMjwUAShiSxiMMrdYbelFFCP6Wf0=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":1,\"text\":\"Pas d'accueil en journée. A évite. D'autres brasserie bien plus accueillante.\",\"language_code\":\"\",\"publish_time\":\"2026-08-27T15:18:05+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Sandrine Malras\",\"uri\":\"https://www.google.com/maps/contrib/109582384644168950109/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKsn0RYWXuwhk6Il6HPdhvsRy15atUHV8HCKRaWczmZFwu8_w=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-07-14T16:52:23+00:00\",\"relative_publish_time\":\"il y a 4 mois\",\"author\":{\"display_name\":\"Patrice DURIEZ\",\"uri\":\"https://www.google.com/maps/contrib/105032052715065047906/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJTg_hIPO8qZL0k_bJ6beqxG2RgbYL1RyEmw0hYH2be-FPfaA=s128-c0x00000000-cc-rp-mo-ba5\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-07-11T00:30:19+00:00\",\"relative_publish_time\":\"il y a 4 mois\",\"author\":{\"display_name\":\"Patrick Leclercq\",\"uri\":\"https://www.google.com/maps/contrib/100568910909618824567/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJMrcnrodidibqeNweEGXpdLe7xR9I5fnLT4Zhl2PaQTjPNHw=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"}]}",
