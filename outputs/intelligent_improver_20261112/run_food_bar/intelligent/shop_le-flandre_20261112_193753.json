              "photo_uri": "https://lh3.googleusercontent.com/a-/ALV-UjWqfgdkuW1N4Ff87lhOpGxE4zTlYRYxJKfU_2Wahc6jdzgGF4sB=s128-c0x00000000-cc-rp-mo-ba4"
