      "google_reviews_json": "{\"place_id\":\"ChIJPY_TTmPVwkcRRhEdaw3suTU\",\"rating\":5,\"user_rating_count\":34,\"google_maps_uri\":\"https://maps.google.com/?cid=3871384897077449030\",\"fetched_at\":\"2026-11-12T19:59:42+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Nous venons de découvrir chez Claudine,  nous avons très bien mangé. Un accueil très chaleureux. Un excellent rapport qualité prix nous recommandons. Merci\",\"language_code\":\"\",\"publish_time\":\"2026-11-09T15:14:30+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Ludovic DUBOIS\",\"uri\":\"https://www.google.com/maps/contrib/116700735818985888260/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLdJYvuzWkVX3xhT0nE8iXSguSdHGewvKIywo6UQT0MAKI5oA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Accueil sympathique et chaleureux , service parfait et les plats sont délicieux !\\nUne belle découverte !\",\"language_code\":\"\",\"publish_time\":\"2026-11-08T20:36:31+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"ANNE LEFEBVRE\",\"uri\":\"https://www.google.com/maps/contrib/102902253825238126676/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjUmZ4fdRB0EA-iz9jo9IROxJuMtNjaXpzBkr0x1oFhIiocGLDs=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Je vous recommande cette adresse. Top!\\nLa cuisine fait maison, l'accueil, le service tout était parfait.\",\"language_code\":\"\",\"publish_time\":\"2026-11-08T10:44:14+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Faustine Tournant\",\"uri\":\"https://www.google.com/maps/contrib/102676701394430998255/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJaN4BauRJhOqtbMbT2u-01JdWLflT3MZ07PzMg_7hiw5Sq_w=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Endroit où tu retrouve le  côté  familial  les repas juste excellent  . A VENIR DÉCOUVRIR  N HÉSITÉ PAS tous est fait maison moment convivial et chaleureux !!\",\"language_code\":\"\",\"publish_time\":\"2026-10-30T21:35:34+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Caroline B\",\"uri\":\"https://www.google.com/maps/contrib/112089559932347096965/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocL4LsDmMmKhVwGDfyr7tpAFh2asqU1LAm-j-xuE9JQ0XTqEvw=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Venez partager un moment de convivialité. Délicieux, goûteux... je recommande à 100% merci à Keryan le chef! Délicieux 😋\",\"language_code\":\"\",\"publish_time\":\"2026-10-30T21:33:05+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"isabelle flament\",\"uri\":\"https://www.google.com/maps/contrib/107123648991796144768/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjUS6vYJBCAwgfQYZtssdTayzo50qN1Yco3SZIQp9cC7VFRO9-UK=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
