      "google_reviews_json": "{\"place_id\":\"ChIJDdlfn4bRwkcRa0n94Ac3TLY\",\"rating\":4.6,\"user_rating_count\":186,\"google_maps_uri\":\"https://maps.google.com/?cid=13135934720111888747\",\"fetched_at\":\"2026-11-12T19:46:16+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-11-10T10:57:49+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Roekeloos Cedric\",\"uri\":\"https://www.google.com/maps/contrib/104847749447583856750/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjW3NktyMrJkHO8ZzlhUWXG-H2hBiQ99Aw7btKMYNH6F5xf_JZHi=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"N’hésitez pas je vous recommande la cuisine est exceptionnelles et les serveurs sont vraiment tops\",\"language_code\":\"\",\"publish_time\":\"2026-11-07T22:22:29+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"karine demond\",\"uri\":\"https://www.google.com/maps/contrib/113871520218653329844/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKYm4WM_5GEhLzuPpP-V1HWqRhlDVVJK6hpjoSNCOAIpMsvEQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Menu, perdrix, délicieux\",\"language_code\":\"\",\"publish_time\":\"2026-11-07T13:54:06+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Bertrand Vtp\",\"uri\":\"https://www.google.com/maps/contrib/107499479530052102531/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJi-aa90l4EG1T1nh28Ka06Kij5rvZDwCtv64Ahl24G73VIEg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Très belle découverte.  Nous avons passé un très bon moment, du début à la fin. Personnel très agréable, qui nous met tout de suite à l'aise et dans l'ambiance du lieu. Quant aux plats, un sans faute, tout était délicieux.\",\"language_code\":\"\",\"publish_time\":\"2026-10-22T11:20:01+00:00\",\"relative_publish_time\":\"il y a 3 semaines\",\"author\":{\"display_name\":\"Aline Gourlin\",\"uri\":\"https://www.google.com/maps/contrib/106571484946469184936/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJA79ikzPXt732tJDQDaEchjvicjF_GlkpJDs5no2MIIeBlOA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":1,\"text\":\"Très mauvaise expérience. À notre arrivée pour notre réservation de ce soir, le manager a installé à notre table un couple qui attendait à l’accueil, puis nous a dirigés vers l’étage, totalement vide, non dressé et dont les lumières étaient éteintes. Il était pourtant déjà 20h15. Lorsque je lui ai fait remarquer que la situation ne nous convenait pas, il m’a répondu \\\"non non l’étage est plein ce soir\\\" ce qui était manifestement contradictoire avec ce que nous avions sous les yeux. La serveuse elle-même semblait surprise de nous y accompagner et d'allumer les lumières. Un manque de considération et de transparence vraiment regrettable dans ce typer d'établissement. Très déçus par cet accueil.\",\"language_code\":\"\",\"publish_time\":\"2026-10-21T18:27:28+00:00\",\"relative_publish_time\":\"il y a 3 semaines\",\"author\":{\"display_name\":\"Alexandra Tomic\",\"uri\":\"https://www.google.com/maps/contrib/106459246046386854066/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLFX1DhDSz22xqyOOUtoeR03hcUbf06Ro_zSlYmo8KYzzocGQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
