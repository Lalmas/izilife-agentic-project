      "google_reviews_json": "{\"place_id\":\"ChIJ27bRzR_TwkcRiVKmqBe_BlI\",\"rating\":4.4,\"user_rating_count\":137,\"google_maps_uri\":\"https://maps.google.com/?cid=5910621669304980105\",\"fetched_at\":\"2026-11-12T19:31:14+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Une pizzeria de qualité avec un patron super sympa!\\nUn délice!\",\"language_code\":\"\",\"publish_time\":\"2026-10-21T19:04:34+00:00\",\"relative_publish_time\":\"il y a 3 semaines\",\"author\":{\"display_name\":\"Ben Da Silva\",\"uri\":\"https://www.google.com/maps/contrib/113741353392584238355/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKAfuS4kkgY9AVRKCQMrgl94KoCJSnjSEmAQVzk3ICNR7XZlQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-08-27T18:51:45+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Vincent TRICOTEAUX\",\"uri\":\"https://www.google.com/maps/contrib/107232111523308244718/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXZ5QVVyxxOZny9v-p8LhQcYH5rBowaS4KUWLPSfqTFA6QITbPGrQ=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"On s'est régalé, les pizzas étaient bien garnie. Au top !\",\"language_code\":\"\",\"publish_time\":\"2026-07-29T18:32:09+00:00\",\"relative_publish_time\":\"il y a 3 mois\",\"author\":{\"display_name\":\"Aurélie Cuvelier\",\"uri\":\"https://www.google.com/maps/contrib/108084414206922724758/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLjODmTTiOmrF0x-vGN9bKlE66yr_faeZVjzaqyLgJ5u_DLBQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Sympa! Efficace! Honnête! à Phalempin... juste à coté de chez vous! Que demander de plus?\\n@ très bientôt Patron!!!!\",\"language_code\":\"\",\"publish_time\":\"2026-07-10T17:29:48+00:00\",\"relative_publish_time\":\"il y a 4 mois\",\"author\":{\"display_name\":\"patrice pecriaux\",\"uri\":\"https://www.google.com/maps/contrib/109405751296345300382/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVari9hW_b06daicIH5MZD8usphQhgbk3NOnIdNmW-hcgEbAbHA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Des amis sont venus à la maison à l'improviste.\\nNous avons l'habitude des très bonnes pizzas de La Bella Vita.\\nNous avons donc décidé de commander des pizzas.\\nJe retire une étoile au service juste pour le délai (les pizzas n'étaient pas prêtes à l'heure indiquée).\\nEn attendant nous avons fait un blind test musicale dans le restaurant.\\n\\nJe recommande car les pizzas sont bonnes et le cuisinier est super agréable.\",\"language_code\":\"\",\"publish_time\":\"2025-11-30T18:13:28+00:00\",\"relative_publish_time\":\"il y a 11 mois\",\"author\":{\"display_name\":\"Charles Derache\",\"uri\":\"https://www.google.com/maps/contrib/102867003304406310606/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjUmfoMycWA1PW9_WN7rzXKavaPP7FTo5Wk_PWWGrGKSljSklcMe=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
