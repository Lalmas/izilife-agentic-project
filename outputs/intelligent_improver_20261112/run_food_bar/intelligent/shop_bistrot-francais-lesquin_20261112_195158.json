      "google_reviews_json": "{\"place_id\":\"ChIJIbLxeCfUwkcRQB281V6jEc4\",\"rating\":3.9,\"user_rating_count\":2847,\"google_maps_uri\":\"https://maps.google.com/?cid=14848829074125364544\",\"fetched_at\":\"2026-11-12T19:51:46+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Très surprise de la qualité des produits fait maison\",\"language_code\":\"\",\"publish_time\":\"2026-11-09T16:31:30+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Virginie Recher\",\"uri\":\"https://www.google.com/maps/contrib/107761565380378462480/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVb7xMbVfCm9rc-46M1mX92iCIN6pxWIbryuFyFXKhteSLWffqmBA=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Une première ce jour, une agréable et très bonne surprise autant sur l'accueil, le service, la qualité , et la variété des plats frais ! Une adresse que je conseille fortement !\",\"language_code\":\"\",\"publish_time\":\"2026-11-08T12:57:15+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Jean Philippe HALLEZ\",\"uri\":\"https://www.google.com/maps/contrib/116412763176497441482/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKm02OJXIqE_0pH6k5lONcxrwl_stOUgq2Z88hfrDwIk4rhOA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"Très pratique, pas d attente, toujours le sourire. Chacun mange ce qu il souhaite et à son rythme. Rapport qualité imbattable. Je recommande pour vos déjeuners du midi.\",\"language_code\":\"\",\"publish_time\":\"2026-11-07T18:12:55+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"THERENCE DESWARTE\",\"uri\":\"https://www.google.com/maps/contrib/101561975446811601476/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjUp_6-_5p04oB-C5yrtz75m6ZSQ-nV9qipB91VpP_A6qww82ZPc=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"Très bon rapport qualité-prix.\\nPersonnel très sympathique\",\"language_code\":\"\",\"publish_time\":\"2026-11-05T18:18:42+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Sabine Pouchelle\",\"uri\":\"https://www.google.com/maps/contrib/109017333396260269133/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXlCX42G2tIzvYLzwUW8b93ll643nrLW6-baavmnS9CPo8Ck3OcbA=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Très bon moment ce midi le jeune serveur senzo parfait nous a bien guidé et avons un peu échangé dans la mesure du possible sans gêner le service le repas étai excellent viande excellente un petit bémol pour les sanitaires à rafraîchir nous reviendrons avec plaisir\",\"language_code\":\"\",\"publish_time\":\"2026-11-04T17:32:56+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Floflo Gathem\",\"uri\":\"https://www.google.com/maps/contrib/112694664658942434849/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJVGMErLrgEJkymJisfvt-0jPMQ7E-bWlvf3EBgUg9Ugp05AQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
