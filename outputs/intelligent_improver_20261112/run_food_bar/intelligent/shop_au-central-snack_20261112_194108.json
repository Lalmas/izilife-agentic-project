      "google_reviews_json": "{\"place_id\":\"ChIJA1Lite4q3UcRTvVpoIov0FM\",\"rating\":4.7,\"user_rating_count\":170,\"google_maps_uri\":\"https://maps.google.com/?cid=6039379372747126094\",\"fetched_at\":\"2026-11-12T01:28:30+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Meilleure friterie que j'ai visité à ce jour. La baguette est délicieuse !\",\"language_code\":\"\",\"publish_time\":\"2026-09-20T17:48:49+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"cléo\",\"uri\":\"https://www.google.com/maps/contrib/115227150678408111648/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWgFFfFZ7LnGjl9d6CxbRUrEs7NREtmQEqbMFGlA6C2rJzKknQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-08-16T15:27:23+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Christine Buzescu\",\"uri\":\"https://www.google.com/maps/contrib/100080128644659114479/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocI2Lg1CQ16iT8PNdyIps3cuSgJU2MjZuEwWN2S_I1nd1sKdJw=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Oh bah Central Snack, c'est devenu un culte, que dis je, une religion\\n\\nRichard est un amour, sa cuisine est vraiment bonne, et en plus il n’a pas la main légère sur les frites\\n\\nAllez y, ou je vous retrouve, et je vous force a prendre un Burger du mois\",\"language_code\":\"\",\"publish_time\":\"2026-08-08T16:08:56+00:00\",\"relative_publish_time\":\"il y a 3 mois\",\"author\":{\"display_name\":\"Zazyoxx\",\"uri\":\"https://www.google.com/maps/contrib/109683659367351100065/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVw1vrnnvoFGHeqJUu4gPwOOT0hyEwxkc4lF-t-JYren0mzBXAbqQ=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Un rapport qualité prix inégalable Top 👍\\nAllez les yeux fermés vous régaler pour un bon hamburger ou meme simplement des frites bon appétit\",\"language_code\":\"\",\"publish_time\":\"2026-07-14T09:58:40+00:00\",\"relative_publish_time\":\"il y a 4 mois\",\"author\":{\"display_name\":\"Nicolas CUISINIER\",\"uri\":\"https://www.google.com/maps/contrib/102876905324792444551/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJNy2azALcwdWvvMVfr_DOdwuhcj3DjzTs5Gv9uUlzn84RZag=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-06-16T15:25:24+00:00\",\"relative_publish_time\":\"il y a 4 mois\",\"author\":{\"display_name\":\"Freddy Wispelaere\",\"uri\":\"https://www.google.com/maps/contrib/102159536133139268486/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWRA89gFCGrmJxuERp94NHAPlJW30DJcISvEMcdRzz10Yge30Xt=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"}]}",
