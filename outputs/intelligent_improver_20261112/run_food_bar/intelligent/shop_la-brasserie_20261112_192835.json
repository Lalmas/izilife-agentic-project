      "google_reviews_json": "{\"place_id\":\"ChIJ08z0j6DBwkcR_pzk6hr1xGQ\",\"rating\":4.5,\"user_rating_count\":329,\"google_maps_uri\":\"https://maps.google.com/?cid=7261197995186887934\",\"fetched_at\":\"2026-11-12T19:28:19+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Très bonne cuisine, plat maison, service impeccable et les tarif sont très raisonnable, petite brasserie embiance familiale, je recommande vivement\",\"language_code\":\"\",\"publish_time\":\"2026-09-26T18:28:46+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"yoda yoda\",\"uri\":\"https://www.google.com/maps/contrib/100574317554447617491/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXfdnuLHbEXgDt1vS_VuqqpZjqMM1MlhMoWLWT1YI-9z3G11OEn=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"C'était tellement bon! L'un des meilleurs tartare que j'ai eu l'occasion de manger ! L'ambiance est top. Le service est top. La nourriture est top ! Les prix sont top ! Merci. Je reviendrai.\",\"language_code\":\"\",\"publish_time\":\"2026-09-04T18:22:10+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Dimitri Degroise\",\"uri\":\"https://www.google.com/maps/contrib/117534217387662082029/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLDIexntjPnKFVDcmDs9-YZeQC_6SHG5FLvQPQOB8vhYFIPeg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-08-11T14:23:55+00:00\",\"relative_publish_time\":\"il y a 3 mois\",\"author\":{\"display_name\":\"Stef s\",\"uri\":\"https://www.google.com/maps/contrib/106151592803289893765/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJ3xErWtc3757AW3v6v0qQrr0F2xo6HjxiGU47MM76p8ZKGDg=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"Repas de famille correct, légèrement salé, par contre, leprix des boissons est exorbitant.\",\"language_code\":\"\",\"publish_time\":\"2026-03-06T11:15:00+00:00\",\"relative_publish_time\":\"il y a 8 mois\",\"author\":{\"display_name\":\"Damien Somson\",\"uri\":\"https://www.google.com/maps/contrib/113012400205559204103/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVd9Y9zpn62mUb75G9gItBWf76Y13NQWS86Y0akYpNt2YCz5Uu2CQ=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2025-12-26T10:20:57+00:00\",\"relative_publish_time\":\"il y a 10 mois\",\"author\":{\"display_name\":\"Alain Fleury\",\"uri\":\"https://www.google.com/maps/contrib/103521150423061275737/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKylwTlUIucOqju-Buxew4r4jAh9qMTiLDNPwaPdXqA6Yf2Ag=s128-c0x00000000-cc-rp-mo-ba5\"},\"google_maps_uri\":\"\"}]}",
