      "google_reviews_json": "{\"place_id\":\"ChIJQ-paNbDRwkcRAaTaR1aKkzI\",\"rating\":4.6,\"user_rating_count\":175,\"google_maps_uri\":\"https://maps.google.com/?cid=3644408626650194945\",\"fetched_at\":\"2026-11-12T20:00:53+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-11-08T09:59:32+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"DUBOIS Philippe\",\"uri\":\"https://www.google.com/maps/contrib/100631505161613404997/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKIsL5Ao1oqQVerTZstzgbOt8e54u_Qs52omnpaC0jTAEMnkQ=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Très sympathique ambiance industrielle très bonne bières et limonades\",\"language_code\":\"\",\"publish_time\":\"2026-10-31T17:46:33+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"judi s\",\"uri\":\"https://www.google.com/maps/contrib/107288420068328701904/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWMy-Rfy7-8QjQxEFh9B5HYHb5zeKSA3RSBIlUwEpB-tMWb5P7U=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":3,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-09-14T09:52:00+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"BAVILLE Ariane\",\"uri\":\"https://www.google.com/maps/contrib/111442462160102513490/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJvA2QdjdvpeoqF-UeAmFhj8oHk7AWBw0MBqkv_mjYBhdUQBQ=s128-c0x00000000-cc-rp-mo-ba5\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"A faire pour les amateurs de bières (et autres !)\",\"language_code\":\"\",\"publish_time\":\"2026-08-27T18:41:47+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"brasseur thomas\",\"uri\":\"https://www.google.com/maps/contrib/115695782739258998670/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjW0GWf1SgV_hnmawozmUFM-tbr_lX30suqzv6mVj0pXuQyokXh_Ew=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":3,\"text\":\"Je  connais les restos du secteur et j avoue que celui ci m a deçu.\\nBière triple plate\\nUn acceuil basique, une mini planche pour 12 euro de 20 cm carrée dont 50% de crudité🤣\\nLe client va se servir au bar es-tu à l'impression de déranger.\\n, je préfère mille fois l ambiance et le service du Qg de la pévele la déco et plus simple mais l ambiance et le service tellement mieux\",\"language_code\":\"\",\"publish_time\":\"2026-07-23T20:21:02+00:00\",\"relative_publish_time\":\"il y a 3 mois\",\"author\":{\"display_name\":\"Francois Duneuf\",\"uri\":\"https://www.google.com/maps/contrib/102166239163960623653/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIRDPaP3mdttO3WRuNNlMdgaQoOqrQxZ8Sz_8s1Id7I506LZg=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"}]}",
