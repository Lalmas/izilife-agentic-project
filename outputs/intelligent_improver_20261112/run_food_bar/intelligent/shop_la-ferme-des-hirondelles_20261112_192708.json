      "google_reviews_json": "{\"place_id\":\"ChIJ-1ekqdPWwkcRS6JzFG6TITI\",\"rating\":4.3,\"user_rating_count\":482,\"google_maps_uri\":\"https://maps.google.com/?cid=3612330477126656587\",\"fetched_at\":\"2026-11-12T19:26:53+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Très bon accueil. La cuisine est faite maison et le service impeccable. Pensez a réserver.\",\"language_code\":\"\",\"publish_time\":\"2026-11-09T07:27:16+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Manu mallet\",\"uri\":\"https://www.google.com/maps/contrib/103605805588920638128/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVKLbU9_k3yrQcPaKPrCQTTrMdSKk4Zfn818cjfPX5rBw2mW_8=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Bon petit estaminet\",\"language_code\":\"\",\"publish_time\":\"2026-11-07T20:47:20+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Philippe Genty\",\"uri\":\"https://www.google.com/maps/contrib/103520091508579582760/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKvCOEW2IwCPfxS3d1zpNuRNG5Hojm323vMinXe2hdG06noSQ=s128-c0x00000000-cc-rp-mo-ba5\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":2,\"text\":\"Désolé mais au vu des commentaires précédents on s'attendait à mieux\\nCuisine correcte mais service laisse a désirer\\nLa jeune femme passe encore mais le serveur devrait changer de métier et si c'est le patron devrait prendre des cours d'amabilité.\",\"language_code\":\"\",\"publish_time\":\"2026-11-07T16:19:45+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Andre Fiquet\",\"uri\":\"https://www.google.com/maps/contrib/110809157162753478296/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKSx2GmTXgvTVfYQzhwETZjs1D7ZUbE97YICT8GVgTUGIKyCg=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-10-01T12:47:07+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Thomas Gérardi\",\"uri\":\"https://www.google.com/maps/contrib/108667914495119330529/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVJhWiaxAu0akvtfuQZkrcxFb17bSFEi8KbBD09Bg2Y1lZwwj96AA=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Merci pour cet excellent moment, nous avons fait un mariage ici et franchement l'ambiance est top et la viande exceptionnelle merci beaucoup 😍😍😍\",\"language_code\":\"\",\"publish_time\":\"2026-09-05T16:35:46+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Matthieu Guaquiere\",\"uri\":\"https://www.google.com/maps/contrib/105298136567586127721/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWay-C2zjxp98H-2c_iMgP9tztxlpcpWVwDlQZxoXJIjifyHJYOkg=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"}]}",
