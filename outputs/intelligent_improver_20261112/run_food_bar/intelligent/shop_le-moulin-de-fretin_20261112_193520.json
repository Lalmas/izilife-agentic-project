      "google_reviews_json": "{\"place_id\":\"ChIJ65VgcNTWwkcRwuLnkk4Szjs\",\"rating\":4.6,\"user_rating_count\":692,\"google_maps_uri\":\"https://maps.google.com/?cid=4309402022121562818\",\"fetched_at\":\"2026-11-12T19:35:09+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-11-07T16:24:07+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Hervé Beauvisage\",\"uri\":\"https://www.google.com/maps/contrib/111470011746353072677/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIS8Nv4W8c4LOWKWg2UOBtr1R_moCx04MIVrcCAXz8lkVJk8g=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"Pour la seconde fois, bon accueil et bons plats.\",\"language_code\":\"\",\"publish_time\":\"2026-10-30T12:35:48+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Jean-Claude perreux\",\"uri\":\"https://www.google.com/maps/contrib/107731532797567357944/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVxgqkHvNtfq3hiZqXVrIp3cfpbTk1C6M3-iM1QFXt0yj8MHlVzYg=s128-c0x00000000-cc-rp-mo-ba5\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Specialités du nord delicieuses, un accueil chaleureux . Staff et patron au top !\",\"language_code\":\"\",\"publish_time\":\"2026-10-17T20:11:25+00:00\",\"relative_publish_time\":\"il y a 3 semaines\",\"author\":{\"display_name\":\"L. S.\",\"uri\":\"https://www.google.com/maps/contrib/106471111109867318874/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIxxbu8Vv5X2YhVC0t-CvJXmebLhCqR_KrVhPyevuzKCeeNyA=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Je vous recommande la carbonade flamande qui est juste succulente ! Ça faisait longtemps que nous n’avions pas mangé une carbonade aussi bonne !\",\"language_code\":\"\",\"publish_time\":\"2026-10-16T19:26:06+00:00\",\"relative_publish_time\":\"il y a 3 semaines\",\"author\":{\"display_name\":\"Cathy FRIZZARIN\",\"uri\":\"https://www.google.com/maps/contrib/110671819133767585257/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjX1Bn2jcYM3oRDWupNIj_y-EJxJYlB8je1rSROAqfiESTN-8qk=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Très bonne adresse, ça faisait longtemps que je n'avais pas aussi bien mangé. La carbonnade, c'est une tuerie ! Service impeccable et très souriant. Je recommande.\",\"language_code\":\"\",\"publish_time\":\"2026-09-25T21:06:28+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Jeremy Debusschere\",\"uri\":\"https://www.google.com/maps/contrib/100902438742408620906/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKuNmyg854ZA76D0g607553XDmPU9q0DS9jFEa6OZ6hGdz_SEQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
