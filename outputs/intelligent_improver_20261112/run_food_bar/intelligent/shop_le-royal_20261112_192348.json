      "google_reviews_json": "{\"place_id\":\"ChIJ17bpu_It3UcRtjDrYfLiDyk\",\"rating\":4.1,\"user_rating_count\":275,\"google_maps_uri\":\"https://maps.google.com/?cid=2958833010858471606\",\"fetched_at\":\"2026-11-12T19:23:37+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":1,\"text\":\"Scandaleux ! Commande prise puis impossible à annuler moins de 1 minute après avoir raccroché, sous prétexte qu’elle était déjà prête… Après plusieurs minutes d’insistance, on m’annonce finalement l’annulation avant de me raccrocher au nez. En rappelant, on me répond : « J’ai un métier, je travaille, je n’ai pas de temps à perdre au téléphone. » Un manque de respect total envers le client ! Après une précédente commande avec des boissons oubliées et 1h30 d’attente pour les récupérer, c’est terminé pour moi. Bravo pour ce changement de direction… 👏👏\",\"language_code\":\"\",\"publish_time\":\"2026-10-12T17:38:28+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Nicolas Vervaecke\",\"uri\":\"https://www.google.com/maps/contrib/111780287944242645714/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocK_ByR-Hrsqu1X0EHW1aEt1DQfKie1nQSXDIRZ0Y2Sru7kcnw=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-09-19T19:12:12+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Nathan Parsy\",\"uri\":\"https://www.google.com/maps/contrib/116527960348274593646/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKTGM7S4UeiYoxnh-ycFLhoVnGsOiOXQ-EkeTTVI0O-DpROlw=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Personnel très gentil et accueillant !\",\"language_code\":\"\",\"publish_time\":\"2026-09-19T19:11:18+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Gaspard\",\"uri\":\"https://www.google.com/maps/contrib/113996368188168000065/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJBD9Z33uqCAf12fCScNyuUuSMTnN2YHiWW0P2FfY91LZ4BoA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Délicieux et propre. Service impeccable ! Je reviendrai sans hésiter.\",\"language_code\":\"\",\"publish_time\":\"2026-09-18T18:24:42+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Cennet K\",\"uri\":\"https://www.google.com/maps/contrib/113243250383346675457/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIhasAk7g8WIKwys1_1uIgWzRvZ0vVPWtZOUhrnEXT6nKgRVA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Pizza excellente.\\nService parfait\",\"language_code\":\"\",\"publish_time\":\"2026-09-02T19:00:33+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Saidane Lassaad\",\"uri\":\"https://www.google.com/maps/contrib/114490853196861553209/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXohXQPy--uS0Var5AT8f7C3vF7YOzGMkof8n96__xIN7S-br11=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"}]}",
