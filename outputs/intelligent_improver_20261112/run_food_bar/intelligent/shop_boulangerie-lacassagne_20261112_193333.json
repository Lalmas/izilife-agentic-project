      "google_reviews_json": "{\"place_id\":\"ChIJ3ykdejnVwkcRacGtlTYD4Hw\",\"rating\":4.4,\"user_rating_count\":298,\"google_maps_uri\":\"https://maps.google.com/?cid=8998195588460560745\",\"fetched_at\":\"2026-11-12T19:33:20+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-10-27T09:20:04+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Blackmoon\",\"uri\":\"https://www.google.com/maps/contrib/118213880799288126554/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXsVQiGUt9Doq4QwwXKElwrcamDJOPkfLq9LJZ8q3NjJZRjWzYZdA=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-10-09T14:52:51+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"gre maroze\",\"uri\":\"https://www.google.com/maps/contrib/108879431851135818663/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjUzlFIsaoESxlUdVfTiZGs5g92Qvz0zoMx0Ixs-Ahor2UHTucc=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":1,\"text\":\"Pas sérieux et pas courtois. Ils annulent des commandes sans prévenir.\",\"language_code\":\"\",\"publish_time\":\"2026-10-09T05:26:33+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Zine Barca\",\"uri\":\"https://www.google.com/maps/contrib/117289468965837090616/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLzJudmeNZKgmP-2eBy-sDMLM0dQv8tM3YeQoEjsXsbYoXjUg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Les produits sont excellents je nes jamais panger de pâtisserie et viennoiseries aussi bonne\",\"language_code\":\"\",\"publish_time\":\"2026-09-12T03:58:43+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Brian Grymonprez\",\"uri\":\"https://www.google.com/maps/contrib/112813603771281922540/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjU5UpfdwsN0D_mza5Oeyvq9HzqaWvj-T3D1mT9_U3Rff4eD7GcJ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Toujours un régal d'y aller. Je trouve le rapport qualité prix correct. De bonnes viennoiseries. La baguette graines est un régal. Le monsieur qui m'accueille a chaque fois est très gentil et à l'écoute. Leur sandwich est fait à la minute. Un thon crudités avec cornichons un régal.\",\"language_code\":\"\",\"publish_time\":\"2026-07-31T13:09:11+00:00\",\"relative_publish_time\":\"il y a 3 mois\",\"author\":{\"display_name\":\"Aurel Verryser\",\"uri\":\"https://www.google.com/maps/contrib/101580568756896639572/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJCa7jTTemnivy8Qtw1cxDM1fS2nMWo13MyYqwMKY0qUf99uA=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"}]}",
