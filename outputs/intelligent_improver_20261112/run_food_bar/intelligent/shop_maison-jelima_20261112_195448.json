      "google_reviews_json": "{\"place_id\":\"ChIJL_KPUfbVwkcRIC80YYV_MEc\",\"rating\":5,\"user_rating_count\":192,\"google_maps_uri\":\"https://maps.google.com/?cid=5129740186413182752\",\"fetched_at\":\"2026-11-12T19:54:37+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Une expérience humaine et gustative dingue, des produits de QUA-LI-TÉ !\\nMention spéciale pour le patron, un personnage inspirant et authentique qui donne le sourire et l’envie de revenir. Merci pour ce moment !\",\"language_code\":\"\",\"publish_time\":\"2026-11-05T16:30:26+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Eliott Miroux\",\"uri\":\"https://www.google.com/maps/contrib/115472064786819758206/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWnSHCSOgNTUyV9gRY0S57JxRR9igYgFOjyfvjLRXi74UyZIdWS=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"En route pour le brunch du dimanche !\\nBeaucoup de plaisir à retrouver les saveurs de mes voyages au Sénégal !\\nLe patron est aux petits soins !\\nOn recommande !\",\"language_code\":\"\",\"publish_time\":\"2026-11-04T16:35:02+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Team Detailing\",\"uri\":\"https://www.google.com/maps/contrib/112939812514024823558/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKsB7-pefTrPZuLKhH05mkhnEqv2yGq2O73qcENi7A1R0dLiQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Bonne ambiance, repas de qualité, personnel aimable. Je recommande !\",\"language_code\":\"\",\"publish_time\":\"2026-11-01T15:54:47+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Haylam Golhe\",\"uri\":\"https://www.google.com/maps/contrib/103598888187662574096/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWsoWnD_tG08r5VLj7A5SEyxSXQaUuggU5cFizvvBUQPbyFKe2k8A=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Un bel endroit pour découvrir des saveurs uniques! Accueil chaleureux, produits de qualité, une adresse qui vaut le détour\",\"language_code\":\"\",\"publish_time\":\"2026-10-26T18:43:47+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"thomas wong fat\",\"uri\":\"https://www.google.com/maps/contrib/100892310189573348480/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjX8O5leWtX5rMYi7kdyFCDwXMR1xNPRimoAyGje9L23-vNy5DDI=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Petit gouter au Jelima ... d'abord le choix s'avère difficile tant toute la carte donne envie. Le jelly mansa (petits beignets) sont a tomber et en portion vraiment généreuse... pour les amateurs de fleurs d'oranger, foncez !\\nService irréprochable, vraiment aux petits soins.\\nJe vous conseille fortement de réserver car peu de place.\\nJe note pour vous soutenir mais on a tellement aimé qu'on aimerait garder l'adresse secrète 😊\\nOn reviendra lors d'un prochain passage dans la région.\",\"language_code\":\"\",\"publish_time\":\"2026-10-26T12:16:27+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Hennion Amandine\",\"uri\":\"https://www.google.com/maps/contrib/118309937969916672343/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocILoyaNvSV9PpeGvzFvG_ZW8tEDAmSj1yf1z8dXkS2wCjaiWQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
