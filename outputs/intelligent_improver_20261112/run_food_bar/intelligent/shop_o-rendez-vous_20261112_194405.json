      "google_reviews_json": "{\"place_id\":\"ChIJC7UicH8t3UcR55BhV-e8Edk\",\"rating\":4.4,\"user_rating_count\":134,\"google_maps_uri\":\"https://maps.google.com/?cid=15641490682623922407\",\"fetched_at\":\"2026-11-12T19:43:50+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-10-24T16:13:38+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"jelonkiewicz maxence\",\"uri\":\"https://www.google.com/maps/contrib/106027543925502510458/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJMHclS_O9RJ6xMqlW74u6JwJP79OIoeVHraPtPsFV-q2FJMg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Bon j’ai mis un peu de temps pour partager mon avis.\\nJ’ai découvert ce lieux par hasard, un jour on se décide d’ouvrir la porte.\\nOn est directement bien accueilli par les propriétaires, et aussi par la clientèle. On se sent vite dans un monde « à part » ou une seule règle d’or, la convivialité.\\nQue se soit pour un simple verre, une partie de fléchette ou de billard, ou un événement à thème on se sent directement accueilli, et on est bien.\\nChapeau à vous deux Tristan et Léa. 👏\",\"language_code\":\"\",\"publish_time\":\"2026-10-01T07:51:49+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Vincent Pecqueur\",\"uri\":\"https://www.google.com/maps/contrib/109230631211994352272/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocL6EG7y1oBud1WkxzSSDDrEs36ErgIC_5JUbAYH5YcpSbsYqg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Bar sympathique personnel au top , une ambiance bon enfant et beaucoup de soirées et événements proposé.\\nUn incontournable pour passer un bon moment\",\"language_code\":\"\",\"publish_time\":\"2026-08-29T17:55:38+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Florian Ziental\",\"uri\":\"https://www.google.com/maps/contrib/105921457491239714663/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIu-f_Ot1NKL-m5Qo0oOZ_xklGeS04LoxapRS--JMhUcFSnag=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-08-11T17:12:40+00:00\",\"relative_publish_time\":\"il y a 3 mois\",\"author\":{\"display_name\":\"Christopher Barrois\",\"uri\":\"https://www.google.com/maps/contrib/107142602011602679643/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJj9Sz7QF9Nv3QOGMWArQVzmKI12EQMVaOfo0zRSj9WZsxpHg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Un bar convivial, sans chichi ! Léa et Tristan sont au top, toujours le sourire 😃\",\"language_code\":\"\",\"publish_time\":\"2026-08-04T17:16:31+00:00\",\"relative_publish_time\":\"il y a 3 mois\",\"author\":{\"display_name\":\"Laurine Pingaud\",\"uri\":\"https://www.google.com/maps/contrib/103096791744649346675/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXbTHXZW1__FoIt40A74bNWhHo0xmPgsQ6avWDx68rqK6tNNMUv=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
