      "google_reviews_json": "{\"place_id\":\"ChIJ1aX4rGjVwkcRSb5qXbkKV0E\",\"rating\":4.8,\"user_rating_count\":101,\"google_maps_uri\":\"https://maps.google.com/?cid=4708243726691647049\",\"fetched_at\":\"2026-11-12T01:29:11+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"rapide bon  excellent\",\"language_code\":\"\",\"publish_time\":\"2026-10-25T14:42:19+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Kenzo Tabary\",\"uri\":\"https://www.google.com/maps/contrib/115567538934603973606/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLWQFxdgLx93YoT3NXV9N5AIDRDy3OHqjlz_RlhdBKySfd6Mg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Un couscous absolument extraordinaire ! 😍 Semoule parfaite, légumes savoureux, viande tendre et bouillon plein de saveurs. Un vrai régal, généreux et authentique. Je recommande les yeux fermés ! 🤤👌\",\"language_code\":\"\",\"publish_time\":\"2026-10-23T13:01:53+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Rymkus\",\"uri\":\"https://www.google.com/maps/contrib/100222642728977327985/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKVc_eHGW3uDzlZNxk48HA8u2UlK-99L141ldVM6_LEftprng=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Je recommande à 100%\\nL’accueil j’en parle meme pas!!!\\nOn est servi avec le sourire et on vous ramène même votre commande à l’extérieur\\nC’est propre, savoureux et bien garni\\nMerci à vous\",\"language_code\":\"\",\"publish_time\":\"2026-09-22T17:23:05+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Fat Bent\",\"uri\":\"https://www.google.com/maps/contrib/113705210266367515297/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIQsKiC4GzRl8EjDj7p46uq_P07AxZatr8SATUJN-8ZRsOQAw=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-09-18T12:31:44+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Karel Nyanda\",\"uri\":\"https://www.google.com/maps/contrib/112798042055758001416/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVVMIn6fopGeEGWRMlC5XblR0uKpIj85oQLgqWPjIGqHSnRHA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-09-16T18:08:06+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Sara Khamassi\",\"uri\":\"https://www.google.com/maps/contrib/115696238428742772887/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKbfzmybzTA63XbF_wlHham-djouJM6Wm1cHqCZaIzVhUsq-Q=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
