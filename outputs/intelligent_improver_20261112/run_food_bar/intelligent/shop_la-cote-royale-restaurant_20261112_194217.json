      "google_reviews_json": "{\"place_id\":\"ChIJAY97vvgq3UcRuPh98gTsfUE\",\"rating\":4.4,\"user_rating_count\":485,\"google_maps_uri\":\"https://maps.google.com/?cid=4719187490546514104\",\"fetched_at\":\"2026-11-12T19:42:07+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-11-07T05:11:42+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Manu B.\",\"uri\":\"https://www.google.com/maps/contrib/114315618776686652121/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKGL6KxGqxgcq-38HPCu0C1MdQpt1VbNA-ft3OzxKTn6v0Atw=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Première fois pour nous et nous avons été très bien accueillis et une très belle ambiance et un super repas  👍.\",\"language_code\":\"\",\"publish_time\":\"2026-11-06T15:30:37+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Aloisia Legrain\",\"uri\":\"https://www.google.com/maps/contrib/107014944562643052875/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLlWyP7yOredzbFntg4v4aKgSplaU4np-cngI7_lsbTRhwaOw=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Toujours un plaisir d'y aller.\\nSuper équipe , patron vraiment génial.\\nUne super adresse\",\"language_code\":\"\",\"publish_time\":\"2026-11-03T16:58:20+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"baba baba\",\"uri\":\"https://www.google.com/maps/contrib/109314786743279995991/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjW92NjzROw1_DRXdeWiFGRtQnIWhrIxzYd096lqp_LyuoO4Odo9=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":3,\"text\":\"J'ai été bien reçu...c'est surtout la décoration qui laisse à désiré.\\nL'ambiance et en fonction de la clientèle\",\"language_code\":\"\",\"publish_time\":\"2026-10-25T06:43:07+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Joel Cappoen\",\"uri\":\"https://www.google.com/maps/contrib/114859801563801485584/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocK7a9Y_j6McLm8sb092K8MZ0etatPM6gcfcdtdc2DepV4Fn1A=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"On a super bien mangé. Du plat principal au dessert 🍨.\",\"language_code\":\"\",\"publish_time\":\"2026-10-24T21:12:17+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Nicolas DEKIMPE\",\"uri\":\"https://www.google.com/maps/contrib/103200952420918798475/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKoYkghLB9RdO08W5oWY7rQ3Lljn06TKIKB9gc-gUVlKf7yKw=s128-c0x00000000-cc-rp-mo-ba5\"},\"google_maps_uri\":\"\"}]}",
