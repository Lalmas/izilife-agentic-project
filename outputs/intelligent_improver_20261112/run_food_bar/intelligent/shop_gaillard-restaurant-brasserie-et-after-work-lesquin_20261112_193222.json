      "google_reviews_json": "{\"place_id\":\"ChIJ37_LRJbXwkcRF0WRDae-Ygs\",\"rating\":4.9,\"user_rating_count\":105,\"google_maps_uri\":\"https://maps.google.com/?cid=820427706831291671\",\"fetched_at\":\"2026-11-12T19:32:10+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Endroit sympathique !\\nCuisine simple mais bonne.\\nJe recommande.\",\"language_code\":\"\",\"publish_time\":\"2026-11-09T19:51:30+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"GUY SAVOY\",\"uri\":\"https://www.google.com/maps/contrib/114495565200585134261/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJ7i9i7vYOcIs_Lr9IczFWjeTJfYydXEAfHqkoJo5p1e1ytiw=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-11-07T18:43:31+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"M C\",\"uri\":\"https://www.google.com/maps/contrib/114668223823639178553/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKi1Qh65zQsS8A7BCXscuzRsn424ONDD5sqoykadsNwiHDt=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Très bon restaurant au service impeccable et prix très corrects.\\nLe Burger welsh vaut le détour!!!\",\"language_code\":\"\",\"publish_time\":\"2026-11-06T10:23:15+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"pierre silanos\",\"uri\":\"https://www.google.com/maps/contrib/112116526727516714550/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLESLkQzppiYpJhvxVGWehdIQenUTSHsNYi2dIr1_rF9tO-lA=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Excellent lieu de rencontre. Bon cocktail et plats délicieux.\",\"language_code\":\"\",\"publish_time\":\"2026-11-03T22:22:33+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Coralie Fauq\",\"uri\":\"https://www.google.com/maps/contrib/105317479359923132988/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWruII6zrJs58ax5aJpD8bIO2EaABr7v8XcEfPvL8CmZDKYD_f61A=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Les frites sont bonnes le patron et les serveuses sont sympas. Belle découverte. On reviendra ! 😉\",\"language_code\":\"\",\"publish_time\":\"2026-11-03T12:58:04+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Florence Dubois\",\"uri\":\"https://www.google.com/maps/contrib/110035495232292343018/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKMSnU8UzAp13AX89mZwHXfq3x7qpqz73QIUa7JAaBJ3b3qlQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
