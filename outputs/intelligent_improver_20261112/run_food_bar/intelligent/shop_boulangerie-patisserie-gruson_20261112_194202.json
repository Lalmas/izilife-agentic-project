      "google_reviews_json": "{\"place_id\":\"ChIJm13JFTPUwkcRQDApyIh7Oy8\",\"rating\":4.4,\"user_rating_count\":151,\"google_maps_uri\":\"https://maps.google.com/?cid=3403449770812452928\",\"fetched_at\":\"2026-11-12T19:41:50+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Les éclairs café ou chocolat sont  délicieux\",\"language_code\":\"\",\"publish_time\":\"2026-10-15T07:14:37+00:00\",\"relative_publish_time\":\"il y a 4 semaines\",\"author\":{\"display_name\":\"Marie Duquenoy\",\"uri\":\"https://www.google.com/maps/contrib/109133296226341883369/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLH4Tlkg-VhGKDDQsx-V7DMohrY5BiEQDTmJkQeePI9_XHemQ=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Une vraie boulangerie pâtisserie avec d’excellents produits.\",\"language_code\":\"\",\"publish_time\":\"2026-09-26T17:27:01+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Hervé LOTTE\",\"uri\":\"https://www.google.com/maps/contrib/100160836204605682269/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjUrCtn53LEPWa1gW7lbKWHwrDCrerKLVLGRL4qWrero025NRpAi=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Veritable boulangerie Artisanale, au moins pour les viennoiseries (je n'ai pas goûté les gâteaux) et le pain.. j'ai retrouvé des pains au chocolat \\\"gourmands\\\" croustillants et bien fournis en chocolat, comme dans mon enfance (années 80)..  On reconnait le \\\"fait main\\\" et les prix ne sont même pas exagérés. Cerise sur le gâteau : la Boulangerie est ouverte dès 7h30 du matin !!  j'ai trouvé la Boulangerie que je cherchais autour de chez moi 👍\",\"language_code\":\"\",\"publish_time\":\"2026-06-11T11:15:40+00:00\",\"relative_publish_time\":\"il y a 5 mois\",\"author\":{\"display_name\":\"Pe L\",\"uri\":\"https://www.google.com/maps/contrib/101495973453527205768/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWftPIcARuON6Ooep-A1803GgjNUEc_2ED5vsfmM3lrWCczi9fL=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":4,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-06-02T11:39:25+00:00\",\"relative_publish_time\":\"il y a 5 mois\",\"author\":{\"display_name\":\"Peggy Watterlot\",\"uri\":\"https://www.google.com/maps/contrib/102248744808636421899/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjU-z5-bwRhALQkCNjeBMxxxPgQYoGRfSi7dnvjk5mLYN62N6k4=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Peut-être la meilleure galette frangipane que j'ai mangé !\\nDe très bonnes pâtisseries également.\\nJe recommande cette boulangerie\",\"language_code\":\"\",\"publish_time\":\"2026-01-11T14:42:32+00:00\",\"relative_publish_time\":\"il y a 10 mois\",\"author\":{\"display_name\":\"Olivier Tryhoen\",\"uri\":\"https://www.google.com/maps/contrib/118128618332923039010/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXQKZj0kr9FdIA6xnZiQ4vqtAO7upxMGg66yroYeMbJS4ccLIFB=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"}]}",
