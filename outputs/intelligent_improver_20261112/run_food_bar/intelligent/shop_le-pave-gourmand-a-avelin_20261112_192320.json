      "closed_state_id": "1",
      "google_reviews_json": "{\"place_id\":\"ChIJbQdtrKPRwkcR2gGPvqaXFnA\",\"rating\":5,\"user_rating_count\":7,\"google_maps_uri\":\"https://maps.google.com/?cid=8076809724152971738\",\"fetched_at\":\"2026-11-12T19:23:06+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Les gauffres un délice ! Je vous les conseille, tel que ma grand-mère les faisait.  Merci également pour le conditionnement pour l envoi ! Merci\",\"language_code\":\"\",\"publish_time\":\"2024-10-28T16:11:19+00:00\",\"relative_publish_time\":\"il y a 2 ans\",\"author\":{\"display_name\":\"Chrystelle Parot\",\"uri\":\"https://www.google.com/maps/contrib/106798295602787389097/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJxXc7OQXdB4LJ309eRL8qHOHBFF_nNH9jhcJPA9sCX762Osw=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Superbe planche, belle présentation, variée en charcuteries et fromages ( bien les écriteaux), pain fourni et prédécoupé = excellent rapport qualité prix !\\nUne planche au prix d'un bouquet de fleurs = vos hôtes seront comblés !\\nA bientôt ...\",\"language_code\":\"\",\"publish_time\":\"2024-10-22T20:29:55+00:00\",\"relative_publish_time\":\"il y a 2 ans\",\"author\":{\"display_name\":\"Sebastien Dutoit\",\"uri\":\"https://www.google.com/maps/contrib/107167876472808691451/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocI-76vSgibKqzVQWlJ_Q-yqlMLTKvwYNHBEI0CYKVbo3rN1Dg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Superbe planche apéro commandée le matin pour le soir\\nExcellent merci\",\"language_code\":\"\",\"publish_time\":\"2024-10-07T07:19:23+00:00\",\"relative_publish_time\":\"il y a 2 ans\",\"author\":{\"display_name\":\"Brigitte Sion\",\"uri\":\"https://www.google.com/maps/contrib/106463092781719109726/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIXQ8m2pZIih9mlpMF2ZPfzCBItknBaEM5a6Vg-x0ee-2H3dg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Je recommande à 100000% bien servi on c régaler à l écoute nous demande bien se qu'on veut on a la choix c super\",\"language_code\":\"\",\"publish_time\":\"2023-11-27T15:56:14+00:00\",\"relative_publish_time\":\"il y a 2 ans\",\"author\":{\"display_name\":\"Caroline Verniest\",\"uri\":\"https://www.google.com/maps/contrib/117443869439486081874/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJSZq9k2tFcgkRcfWnYn47F2GTs-iOseNituG_j4RrrjdKEPNtG=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Venue exprès de Saint Omer pour les planches de Mélinda 😍 ,encore une fois pas déçu et sa planche qui a fait le bonheur de mes invités. Sérieuse dans la préparation de ses commandes, c’est un délice pour les yeux comme pour les papilles.\\nJe vous la recommande fortement n’hésitez vous ne serez pas déçu ☺️\",\"language_code\":\"\",\"publish_time\":\"2023-10-04T16:39:33+00:00\",\"relative_publish_time\":\"il y a 3 ans\",\"author\":{\"display_name\":\"Blandine GULIBERT\",\"uri\":\"https://www.google.com/maps/contrib/100611664228884970716/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJj0Mo-r1YUMqWsyr8lukaw9NOqFowdwxrczb5ft3aPJ8jfrMg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
