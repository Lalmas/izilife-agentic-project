      "google_reviews_json": "{\"place_id\":\"ChIJEcFnE67V3EcRELgG30GH2Jk\",\"rating\":4.9,\"user_rating_count\":34,\"google_maps_uri\":\"https://maps.google.com/?cid=11085759199756859408\",\"fetched_at\":\"2026-11-12T19:46:45+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Atelier enfant fait ce jour avec notre enfant, chouette moment en famille, endroit chaleureux et les gâteaux et boissons sont délicieuses\\nNous recommandons et reviendrons profiter de nouveaux ateliers (et de la carte☺️)\\nÀ très vite 🌼\",\"language_code\":\"\",\"publish_time\":\"2026-10-17T21:07:46+00:00\",\"relative_publish_time\":\"il y a 3 semaines\",\"author\":{\"display_name\":\"Sophie\",\"uri\":\"https://www.google.com/maps/contrib/115375061742525328452/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLCeN3bwOedGawnR_w3mv4JR6rLxzREehZzPwM-w9Ie-EqOQA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Nous avons était très satisfait de notre découverte,\\nJ'ai adoré le matcha fraise : excellent 😁\\nNous reviendrons avec plaisir\",\"language_code\":\"\",\"publish_time\":\"2026-09-18T11:29:03+00:00\",\"relative_publish_time\":\"il y a un mois\",\"author\":{\"display_name\":\"Céline Drm\",\"uri\":\"https://www.google.com/maps/contrib/108655321088801349926/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKc18kgiLd4bSCW5cTcjvI7uJHSrtDmvV2ZK-ri8IDriPq2jlCU=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-08-23T13:27:28+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Shoto Todoroki\",\"uri\":\"https://www.google.com/maps/contrib/109080992500465920057/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWdaceyNKSW69_LMZ9V1EioR99Hmsic8-I0jjMgu4btxzjWUT_9=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Really nice place, the dessert was delicious and the coffe 10 out of 10 👌🏻\",\"language_code\":\"\",\"publish_time\":\"2026-08-22T11:54:59+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"maria jose briones rodriguez\",\"uri\":\"https://www.google.com/maps/contrib/106776253188994736190/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjX4uURHVv345uTkIJ4qHPjo1W0AUp-pFK713ez3O9yK6LFAyTwT=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Superbe endroit où faire une petite pause pendant une balade à vélo près du canal ! Jean marc a été adorable, un monsieur plein de bienveillance 🤗 Et en plus de ça je me suis régalée ! Je vous le recommande !!\",\"language_code\":\"\",\"publish_time\":\"2026-08-22T10:16:07+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Laurie Limousin\",\"uri\":\"https://www.google.com/maps/contrib/101178692347409850248/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjX3DMbFOF1Ap4a7MHMFOJrAlanRNVAS49iJi3UZcXKzLjs9BpluwA=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"}]}",
