      "google_reviews_json": "{\"place_id\":\"ChIJC1Ds6orrwkcRak3w0YcpENE\",\"rating\":4.6,\"user_rating_count\":63,\"google_maps_uri\":\"https://maps.google.com/?cid=15064586416873819498\",\"fetched_at\":\"2026-11-12T19:43:08+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Super endroit où on se sent comme chez soi, l’accueil est top, la cuisine excellente, le personnel très pro\\nMerci à Tahir, Sonia et David.\\n\\nMerci à eux, venez les yeux fermés\",\"language_code\":\"\",\"publish_time\":\"2026-07-15T16:30:54+00:00\",\"relative_publish_time\":\"il y a 4 mois\",\"author\":{\"display_name\":\"Tiens Retiens\",\"uri\":\"https://www.google.com/maps/contrib/117337702909192951931/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVBQo6nZbuYGDAtPkvObotOCXIvjrLQMfGco8nADUCiDvLy8NSq=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Établissement sans chi chi ambiance conviviale, cuisine excellente et copieuse, patronne très accueillante et sympathique\\nJe recommande sans hésitation\",\"language_code\":\"\",\"publish_time\":\"2026-06-29T08:20:50+00:00\",\"relative_publish_time\":\"il y a 4 mois\",\"author\":{\"display_name\":\"Claude Coquelet\",\"uri\":\"https://www.google.com/maps/contrib/103103492454676693512/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIEp38Cpwo7d6pD6s6w8eBxw0A_NDYj2mVukJVGDg2lYrWCSQ=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Le service était au top, accueil chaleureux, la nourriture est excellente bravo 👏\",\"language_code\":\"\",\"publish_time\":\"2026-04-24T15:33:03+00:00\",\"relative_publish_time\":\"il y a 6 mois\",\"author\":{\"display_name\":\"halil kovanci\",\"uri\":\"https://www.google.com/maps/contrib/112077142025812518978/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJvSqE-l3QVHYjuBhKXDgQGOSbyNRelaURVZ1m9zrORPW2scvA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Super service\",\"language_code\":\"\",\"publish_time\":\"2026-03-28T18:02:09+00:00\",\"relative_publish_time\":\"il y a 7 mois\",\"author\":{\"display_name\":\"Alain vafc\",\"uri\":\"https://www.google.com/maps/contrib/110451336595731385084/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjWYOlfgFlpqjAEQXhXCYc7_o7EpaEtiYx3wtENBsVUvM6uwbkIYMQ=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":2,\"text\":\"Très déçu. La cuisine est basique et manque clairement de saveurs.\\nLa serveuse passe plus de temps à discuter et boire au bar qu’à s’occuper des clients, comme si elle était entre copines.\\nRésultat : erreur d’encaissement lors de mes deux visites.\\nJe pensais avoir trouvé une bonne adresse, mais je n’y retournerai pas.\",\"language_code\":\"\",\"publish_time\":\"2026-03-23T06:08:39+00:00\",\"relative_publish_time\":\"il y a 7 mois\",\"author\":{\"display_name\":\"Anthony Vanlek\",\"uri\":\"https://www.google.com/maps/contrib/101924149942500710777/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIhbTQPSoJTEOxuZeFLzLK48U-ffCCpH3C9m7EYdg_sFDcEIA=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"}]}",
