      "google_reviews_json": "{\"place_id\":\"ChIJ6_HKF3bVwkcRjbkN13fGh7c\",\"rating\":4.7,\"user_rating_count\":58,\"google_maps_uri\":\"https://maps.google.com/?cid=13224757048808159629\",\"fetched_at\":\"2026-11-12T19:35:39+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Coup de coeur pendant le marché de wazemmes. Thé à la menthe et les oeufs olives pain 👍\",\"language_code\":\"\",\"publish_time\":\"2026-10-25T11:18:03+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"virginie van\",\"uri\":\"https://www.google.com/maps/contrib/103512411161745212792/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLOvZy5iTjr3KcEN-ftffS6FHMpsOlKNVIo4WgSH_qJAFCWrw=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Salon de thé et boulangerie très sympa avec un brunch maghrébin, composé d'une bissara, d'œufs au plat et de thé, traditionnel. Ambiance très agréable,  le personnel est sympathique. C'est très propre. Je recommande !\",\"language_code\":\"\",\"publish_time\":\"2026-10-18T08:37:29+00:00\",\"relative_publish_time\":\"il y a 3 semaines\",\"author\":{\"display_name\":\"Wow Events Paris\",\"uri\":\"https://www.google.com/maps/contrib/104842984589401997022/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjX6TgC9sMYHtsSTQvMVkaA6JBM0MCVUUD8pXHV1i3HP9NmJmpc=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Une super découverte sur le marché de Wazemmes !\\nJe passe devant depuis des années sans m'arrêter, et quelle belle surprise ! Ouverte depuis 28 ans, cette boulangerie offre un bel espace avec une grande salle intérieure et une terrasse extérieure très agréable.\\nL'accueil y est formidable, toujours avec le sourire. Côté prix, c'est imbattable : la formule café + viennoiserie à 2,50 € vaut vraiment le détour.\\nUne excellente adresse locale que je recommande vivement !\",\"language_code\":\"\",\"publish_time\":\"2026-09-13T10:59:42+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Pascal Antonio\",\"uri\":\"https://www.google.com/maps/contrib/110927323060269900585/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVwwZRwu42gbjYJjMZAxAnYk1yfTwwL7DqbWeDq6qsW7LfQ9Ek=s128-c0x00000000-cc-rp-mo-ba6\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-08-14T13:07:54+00:00\",\"relative_publish_time\":\"il y a 3 mois\",\"author\":{\"display_name\":\"bourin hafssa\",\"uri\":\"https://www.google.com/maps/contrib/111000081992952148356/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJkGDThO_ysOWyOBYcrU3Q6XDmqb9tr236PTODWcSiAGQ7LrXE=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Formule brunch + poulet mariné, c’était excellent !\",\"language_code\":\"\",\"publish_time\":\"2026-05-31T07:04:38+00:00\",\"relative_publish_time\":\"il y a 5 mois\",\"author\":{\"display_name\":\"Amchum Ratal\",\"uri\":\"https://www.google.com/maps/contrib/102618568286951794563/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocJGpWhPv5CIWD1fCV_R5Kja8f5xkT25U7KI5Xf9ZROYfPnkGA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
