      "google_reviews_json": "{\"place_id\":\"ChIJ6W0QcQ3RwkcR57Rk7_apld0\",\"rating\":4.3,\"user_rating_count\":263,\"google_maps_uri\":\"https://maps.google.com/?cid=15966854931955365095\",\"fetched_at\":\"2026-11-12T19:35:22+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Super lieu\\nSuper produits\",\"language_code\":\"\",\"publish_time\":\"2026-11-10T12:07:12+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Julia Martinez\",\"uri\":\"https://www.google.com/maps/contrib/108798498144664686061/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKOMTa6U5dWI_qzapqogx-2zSUvvhrUF1AVpn5vX56RZ32tPw=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Je tiens à féliciter Héloïse Delain pour son professionnalisme et la qualité de son accueil. En tant que directeur d’entreprise, je me rends régulièrement dans cette boulangerie pour acheter des croissants, du pain, des petits pains et des chocolats pour mes employés.\\n\\nJ’ai notamment eu l’occasion de faire appel à elle pour résoudre un problème, et elle a su le gérer avec sérieux, patience et efficacité. C’est une vendeuse ponctuelle, agréable, à l’écoute des clients et toujours professionnelle.\\n\\nJe recommande vivement Héloïse pour son excellent travail, sa patience et son sens du service. C’est un véritable plaisir d’être accueilli par une personne aussi investie dans son métier.\",\"language_code\":\"\",\"publish_time\":\"2026-10-29T08:48:48+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Clé Confiance\",\"uri\":\"https://www.google.com/maps/contrib/109626199821341116168/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLBIMspckqddI6tllwGff9yKA_NV87WSBKRmZgCAIZeU2oxSw=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":1,\"text\":\"Qualité comparable à Lidl.. aucun intérêt\",\"language_code\":\"\",\"publish_time\":\"2026-10-24T06:47:03+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"gheerardyn quentin\",\"uri\":\"https://www.google.com/maps/contrib/104872318838507872572/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocIDm32VMDMY2VhtV4grkwXp9_ZBj5K2YrjAjYOEskwpCgOhVw=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Une excellente boulangerie avec un personnel toujours souriant et accueillant, Merci !\",\"language_code\":\"\",\"publish_time\":\"2026-10-24T06:28:53+00:00\",\"relative_publish_time\":\"il y a 2 semaines\",\"author\":{\"display_name\":\"Chris\",\"uri\":\"https://www.google.com/maps/contrib/104431159962462330707/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLcRcF8G2Pni_ptXUPMH_EH_T6FZN8J-PqjoUPoy7onwyTCbg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-08-18T12:08:36+00:00\",\"relative_publish_time\":\"il y a 2 mois\",\"author\":{\"display_name\":\"Domi-mini Belm\",\"uri\":\"https://www.google.com/maps/contrib/117194085149433653698/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjVGJtAXCRxM7jcyQoAX73WC6LGhiuyppf2WC3xLgoiBdaJHLEJ9=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"}]}",
