      "google_reviews_json": "{\"place_id\":\"ChIJ8wT3K7Es3UcRL8EUx3887Ok\",\"rating\":4.7,\"user_rating_count\":281,\"google_maps_uri\":\"https://maps.google.com/?cid=16855914024839463215\",\"fetched_at\":\"2026-11-12T19:38:35+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Parfait nous y sommes allés 2 fois lors de notre séjour et franchement je n'ai vu aucun changement avec les anciens propriétaires toujours aussi bon nous n'avons pas de frites aussi bonnes dans notre region donc ça fait plaisir. De plus resto propre ce n'est pas partout (nous avons manger sur place) nous reviendrons merci à vous\",\"language_code\":\"\",\"publish_time\":\"2026-11-10T23:08:46+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Karen Taine\",\"uri\":\"https://www.google.com/maps/contrib/107627870052409672552/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKtn4xE-XlT9J3EaZ6xFvKNrn4aK4GhfwYcQkzUnpG6XdYhfg=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Accueil souriant, rapport qualité prix au top. Ont a bien mangés. Nous reviendrons !\",\"language_code\":\"\",\"publish_time\":\"2026-11-08T08:42:23+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Yolanda\",\"uri\":\"https://www.google.com/maps/contrib/111614558551570382773/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocK53o0hK7_qBCJwZihII_9y00gB2ka79x11XtCZU2K7tJ_k_A=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Le personnel est très accueillant La propreté est irréprochable et le service rapide, je reviendrai sans hésiter\",\"language_code\":\"\",\"publish_time\":\"2026-11-07T21:56:07+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Matéo Turpin\",\"uri\":\"https://www.google.com/maps/contrib/106993516801915869944/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLPoVChSXfiUm1GhLCjcKMyepGCZxhhs00uKDxZe9bL3y9EDw=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Super friterie ! Le personnel est toujours très souriant, accueillant et agréable. Le service est rapide, avec très peu d’attente, même quand il y a du monde. C’est vraiment appréciable ! Je recommande sans hésiter ! 😊\",\"language_code\":\"\",\"publish_time\":\"2026-11-07T17:06:02+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Jueml\",\"uri\":\"https://www.google.com/maps/contrib/104778223657723162189/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocI2qIJvVP_CeQrPreafwjRna8My-54pq_uiTU11-WBNmBTWkg=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"R.A.S top !\",\"language_code\":\"\",\"publish_time\":\"2026-11-07T17:04:52+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Constantin\",\"uri\":\"https://www.google.com/maps/contrib/100511349106266273242/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjU2z9jfg0rr0wpQbVh8Z1maBMmTOZ6qJWh95MKrw8vKPF4Fj0Q=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"}]}",
