      "google_reviews_json": "{\"place_id\":\"ChIJbx0nDXTVwkcRFxEVEBXFQpY\",\"rating\":4.7,\"user_rating_count\":479,\"google_maps_uri\":\"https://maps.google.com/?cid=10827433148406894871\",\"fetched_at\":\"2026-11-12T19:21:47+01:00\",\"reviews\":[{\"name\":\"\",\"rating\":5,\"text\":\"Cuisine travaillé avec soins, serveurs et serveuses très agréables.\\nIl faut que j’arrive à y venir plus souvent.\\nPour des prix que l’on se doit d’accepter en 2026.\\nÀ essayer, vous verrez, très bon rapport qualité / prix.\",\"language_code\":\"\",\"publish_time\":\"2026-11-11T13:03:20+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Marc Flament\",\"uri\":\"https://www.google.com/maps/contrib/103734284881841312834/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocKhxV9J2WjeLVHMWs2WvfYhMOUhY3RqGJqO5GhsA__NuUtUlA=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Super restaurant équipe au top produits frais de saison carte qui varie selon la saison.👍.👍\\nTrès bons cocktails et happy a hour au top avec planche a partager de qualité 🍸🥂\",\"language_code\":\"\",\"publish_time\":\"2026-11-08T10:18:04+00:00\",\"relative_publish_time\":\"il y a moins d'une semaine\",\"author\":{\"display_name\":\"Damien Latour\",\"uri\":\"https://www.google.com/maps/contrib/112390783912791771463/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjUC55lTmQiZlUz0jOFofeSQYMrhZehr9cvNT9kVrajDlBQR6Ek=s128-c0x00000000-cc-rp-mo\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-11-04T11:39:50+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Lucas Lefèvre\",\"uri\":\"https://www.google.com/maps/contrib/100737866503691606789/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjUzxArOUi0xxJ9R5_JHy8EU2SV1mCZa1Fn-Fp7YfI9Jg9RUj68-8g=s128-c0x00000000-cc-rp-mo-ba4\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"\",\"language_code\":\"\",\"publish_time\":\"2026-11-02T05:20:11+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Franck59\",\"uri\":\"https://www.google.com/maps/contrib/106147987500471313796/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a/ACg8ocLsoY91VMunLWrrD_ZgthvYXqj9OQtYuqT8GBPXaLqnzjLLBw=s128-c0x00000000-cc-rp-mo-ba2\"},\"google_maps_uri\":\"\"},{\"name\":\"\",\"rating\":5,\"text\":\"Allez y les yeux fermés, c'est toujours avec un grand plaisir que nous y allons, cuisine faite maison, généreuse, délicieuse, avec un large choix de plats régionaux. Le personnel est sympatique et professionnel, les prix raisonnables. Je vous recommande cet endroit.\",\"language_code\":\"\",\"publish_time\":\"2026-11-01T07:48:33+00:00\",\"relative_publish_time\":\"il y a une semaine\",\"author\":{\"display_name\":\"Nath Lamand\",\"uri\":\"https://www.google.com/maps/contrib/117134230414558809860/reviews\",\"photo_uri\":\"https://lh3.googleusercontent.com/a-/ALV-UjXV6wgJrr_COKb45RRBrlKvUm_8ztFV_9xrKAbN-nnTtmshLHHO2A=s128-c0x00000000-cc-rp-mo-ba3\"},\"google_maps_uri\":\"\"}]}",
