MAILTO=""

# ============================================================
# ÉVÉNEMENTS
# ============================================================
# Collecte locale des endpoints Hub bloqués depuis l'IP serveur (Seclin,
# Wattignies, puis les lignes actives ajoutées dans hubs/local_hub_endpoints.xlsx).
# Le poste local récupère les pages ; le Hub serveur conserve découverte,
# nettoyage, lots LLM, dédoublonnage et EventTmp.
# DÉSACTIVÉ : décommenter seulement après validation manuelle des endpoints locaux.
#30 23 * * * /bin/zsh -lic 'cd /Users/lal/izilife-agentic-project/scripts/izilife || exit 1; echo "\n===== START local-hub $(date) ====="; .venv/bin/python hubs/local_hub_collector.py --workbook=hubs/local_hub_endpoints.xlsx --env=.env; rc=$?; echo "===== END local-hub rc=$rc $(date) ====="; exit $rc' >> /Users/lal/Library/Logs/izilife-cron.log 2>&1
