# ============================================================
# ÉVÉNEMENTS
# ============================================================
30 21 * * 4 /bin/zsh -lic 'cd /Users/lal/izilife-agentic-project/scripts/izilife && echo "\n===== START shotgun $(date) =====" && .venv/bin/python events/shotgun_scraper.py --env=prod --city=lille && echo "===== END shotgun $(date) ====="' >> /Users/lal/Library/Logs/izilife-cron.log 2>&1
