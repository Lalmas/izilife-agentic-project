# ============================================================
# TRANSFERTS PILOTÉS — FILE DRIVE
# ============================================================
# Ne traite que les lignes pending du classeur transfers.xlsx.
# PLACE/SHOP/PAGE/EQUIPMENT : applique seulement une ligne ACTION=APPLY ayant déjà un plan figé applicable.
# EVENT/EXPERIENCE/EVENT_SERIE/ANNUAL_CELEBRATION/REPRESENTATION : prépare la revue BO à quatre yeux ; aucune conversion aveugle.
50 1 * * * /bin/zsh -lic 'cd /Users/lal/izilife-agentic-project/scripts/izilife || exit 1; echo "\n===== START transfers $(date) ====="; .venv/bin/python commercial_centers/transfer_pilot.py run --zone=lille --env=prod --apply --confirm-production=I_CONFIRM_PRODUCTION_TRANSFER; rc=$?; echo "===== END transfers rc=$rc $(date) ====="; exit $rc' >> /Users/lal/Library/Logs/izilife-cron.log 2>&1

